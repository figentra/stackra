{
  "name": "@figentra/service-example",
  "version": "0.0.1",
  "private": true,
  "description": "The reference example service: one tenant-owned resource (notes) through the actions pipeline.",
  "keywords": [
    "example",
    "notes",
    "reference",
    "stackra",
    "tenancy"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/services/example#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "UNLICENSED",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "services/example"
  },
  "type": "module",
  "imports": {
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ],
    "#config/*": [
      "./src/config/*",
      "./src/config/*.ts",
      "./src/config/*.tsx",
      "./src/config/*/index.ts"
    ],
    "#contracts/*": [
      "./src/contracts/*",
      "./src/contracts/*.ts",
      "./src/contracts/*.tsx",
      "./src/contracts/*/index.ts"
    ],
    "#modules/*": [
      "./src/modules/*",
      "./src/modules/*.ts",
      "./src/modules/*.tsx",
      "./src/modules/*/index.ts"
    ],
    "#assets/*": "./assets/*",
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "exports": {
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "dev": "stackra dev",
    "build": "stackra build",
    "typecheck": "stackra typecheck",
    "lint": "stackra lint",
    "test": "stackra test",
    "test:int": "stackra test --tier int",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo .stackra"
  },
  "dependencies": {
    "@stackra/actions": "workspace:*",
    "@stackra/app": "workspace:*",
    "@stackra/console": "workspace:*",
    "@stackra/container": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/database": "workspace:*",
    "@stackra/entitlements": "workspace:*",
    "@stackra/errors": "workspace:*",
    "@stackra/events": "workspace:*",
    "@stackra/iam": "workspace:*",
    "@stackra/model": "workspace:*",
    "@stackra/queue": "workspace:*",
    "@stackra/scheduler": "workspace:*",
    "@stackra/scope": "workspace:*",
    "@stackra/tenancy": "workspace:*",
    "@stackra/validation": "workspace:*",
    "encore.dev": "1.58.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@electric-sql/pglite-pgvector": "catalog:",
    "@faker-js/faker": "catalog:",
    "@mikro-orm/pglite": "catalog:",
    "@stackra/cli": "workspace:*",
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "testcontainers": "catalog:",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "service",
    "runtimes": [
      "node"
    ],
    "summary": "The reference example service: a tenant-owned notes resource (create, get, list, update, delete) through the actions pipeline with permissions, row-level tenant isolation, validation and events; read it for the shape of a complete service."
  }
}
