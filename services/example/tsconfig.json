// TypeScript project for this member: extends exactly one @stackra/typescript-config preset (pnpm validate checks the
// preset). Its compilerOptions hold only paths: each package.json imports key with its first target (no baseUrl:
// TypeScript 7 removed it), because Encore ignores imports, reads paths only here and honours one target per key
// (ADR 0091); `stackra encore:prepare` writes them. The typecheck reads gen's .stackra/tsconfig.typecheck.json, this
// file without paths. tsc reads tsconfig.json as JSONC, so the name stays .json.
// Owner: release-operations · Secrets: forbidden
{
  "extends": "@stackra/typescript-config/node",
  "compilerOptions": {
    "paths": {
      "#src/*": ["./src/*"],
      "#stackra/*": ["./.stackra/gen/*"]
    }
  }
}
