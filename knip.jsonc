// Stackra file contract:
// Purpose: unused files/exports/dependencies detection. Runs in `pnpm verify`. Workspace globs for members that do
//          not exist yet are listed on purpose: knip prints a hint, not a failure, and the entry is right the day
//          the member lands.
// Owner: release-operations · Secrets: forbidden
{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/scripts/*.mjs"],
      "project": ["*.mjs", "tools/scripts/*.mjs"],
      // Run by lefthook's pre-commit hook, which knip does not read.
      // @changesets/config: .changeset/config.json reads its schema from pnpm's hidden hoist
      // (a transitive of @changesets/cli) so VS Code needs no download; it is never imported.
      "ignoreDependencies": ["oxfmt", "@changesets/config"],
      // Developer-machine CLIs the root scripts shell out to (pinned outside pnpm).
      "ignoreBinaries": ["opencode", "infisical", "specify"],
    },
    "packages/tooling/*": {
      // Config packages export presets by subpath (package.json exports); the only TS besides them is their test.
      "entry": ["src/*.ts", "src/**/__tests__/**/*.test.ts"],
      "project": ["*.ts", "src/**/*.ts"],
      // Extended by each preset package's tsconfig.json, which knip doesn't trace where no typecheck script runs.
      // @commitlint/config-conventional: named as a string in the commitlint preset's `extends`, which knip doesn't trace.
      "ignoreDependencies": ["@stackra/typescript-config", "@commitlint/config-conventional"],
    },
    "packages/*/*": {
      "project": ["src/**/*.{ts,tsx}"],
    },
    "apps/*": {
      // gen finds the root module by name (ADR 0294 R12); src/main.* is the stand-in entry until gen writes it; a
      // component folder's index.ts is its public surface (ADR 0294 decision 14).
      "entry": ["src/main.{ts,tsx}", "src/*.module.ts", "src/components/*/index.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      // Read by the CSS @imports in src/styles/, which knip doesn't trace; expo-updates: knip's expo
      // plugin assumes OTA updates.
      "ignoreDependencies": ["@stackra/tokens", "@heroui/styles", "expo-updates"],
    },
    "apps/mobile": {
      "project": ["src/**/*.{ts,tsx}"],
      // app.json declares no OTA updates; knip's expo plugin assumes them.
      // @stackra/tokens: read by src/global.css (the Uniwind theme), which knip doesn't trace.
      "ignoreDependencies": ["expo-updates", "@stackra/tokens"],
    },
    "workers/*": {
      "project": ["src/**/*.ts"],
    },
    "services/*": {
      // gen finds the root module by name (ADR 0294 R12); a v2 service still names it in `stackra.module`.
      "entry": ["src/*.module.ts"],
      "project": ["src/**/*.ts"],
    },
    "apps/docs": {
      // Mintlify content is MDX rendered by the `mint` CLI; there is no JS entry.
      "entry": [],
      "project": [],
    },
  },
  // `mint`: Swift's Mint runner, a fallback in lefthook's generated hooks.
  // Scaffold templates are inert text with {{tokens}}; the generated members are checked once they exist.
  "ignore": ["tools/scaffold/templates/**", "**/__tests__/fixtures/**"],
  "ignoreBinaries": ["gitleaks", "mint"],
  "rules": {
    // Catalog entries are declared ahead of the members that consume them; `warn` keeps a dead one visible.
    "catalog": "warn",
  },
  "includeEntryExports": false,
}
