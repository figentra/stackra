// Stackra file contract:
// Purpose: unused files/exports/dependencies detection. Runs in `pnpm verify`. Workspace globs for members that do
//          not exist yet are listed on purpose: knip prints a hint, not a failure, and the entry is right the day
//          the member lands.
//          Unused catalog entries are errors (stackra-235, rule-gap B-10). Unlisted dependencies and duplicate
//          exports in gen output are not reported (stackra-247, STA-1299, see `ignoreIssues`).
// Owner: release-operations · Secrets: forbidden
{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/scripts/*.mjs"],
      "project": ["tools/scripts/*.mjs"],
      // @changesets/config: .changeset/config.json reads its schema from pnpm's hidden hoist
      // (a transitive of @changesets/cli) so VS Code needs no download; it is never imported.
      // jscpd: tools/scripts/duplication.mjs spawns its binary by path (node_modules/.bin/jscpd), which knip does not trace.
      "ignoreDependencies": ["@changesets/config", "jscpd"],
      // Developer-machine CLIs the root scripts shell out to (pinned outside pnpm). wrangler: the reusable
      // runway-cloudflare-workers workflow runs `pnpm exec wrangler` in the Worker member's folder, and the member
      // (workers/static) declares it; knip attributes workflow commands to the root. playwright and stackra: the
      // reusable runway-smoke workflow runs them in the product repository that calls it, where @stackra/cli and
      // @stackra/runway's optional Playwright peer are installed (STA-265).
      "ignoreBinaries": ["opencode", "infisical", "specify", "wrangler", "playwright", "stackra"],
    },
    "packages/tooling/*": {
      // Config packages export presets by subpath (package.json exports, which knip reads as entries); the only TS
      // besides them is their test.
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["*.ts", "src/**/*.ts"],
    },
    "packages/tooling/commitlint": {
      "entry": ["src/**/__tests__/**/*.test.ts"],
      "project": ["*.ts", "src/**/*.ts"],
      // Named as a string in the preset's `extends`, which knip doesn't trace.
      "ignoreDependencies": ["@commitlint/config-conventional"],
    },
    "packages/*/*": {
      // stackra.config.ts: the member definition gen reads (ADR 0295 decision 1); it imports `definePackage`, so a
      // member whose src/ never imports @stackra/contracts still uses it. .stackra/: gen's output (wiring, registrations,
      // module, entries, test setup) imports packages src/ never does, which the member declares for it
      // (generated_dependency_missing); knip reads it when gen has run. vitest.config.ts: the authored test config
      // that merges gen's (stackra-163); named so its @stackra/vitest-config import is always seen (stackra-247);
      // knip's vitest plugin already finds vitest.int.config.ts, the int tier (STA-1570). plugin/: an Expo module package's config plugin
      // (ADR 0478 decision 2), which app.plugin.js loads from dist/, so knip starts at its source index.
      "entry": [
        "stackra.config.ts",
        "vitest.config.ts",
        ".stackra/**/*.{ts,tsx}",
        "plugin/index.ts",
        "plugin/src/index.ts",
      ],
      "project": ["src/**/*.{ts,tsx}", "plugin/**/*.ts"],
    },
    // A member listed by name replaces the packages/*/* entry for it, so it repeats entry and project.
    // vite-plugin ships CSS that knip compiles (Tailwind), so its project includes it.
    "packages/developer/vite-plugin": {
      "entry": ["stackra.config.ts", ".stackra/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx,css}"],
    },
    "packages/runtime/cache": {
      "entry": ["stackra.config.ts", ".stackra/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      // `cloudflare:workers` is a workerd built-in module (the ./worker entry), not the npm `cloudflare` SDK.
      "ignoreDependencies": ["cloudflare"],
    },
    "packages/developer/mcp": {
      "entry": ["stackra.config.ts", ".stackra/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      // encore: the Encore CLI (brew, mise.toml); stackra: the bin of @stackra/cli, which depends on @stackra/mcp, so
      // the MCP server spawns it from PATH (`pnpm exec stackra mcp`) instead of declaring it (a cycle).
      "ignoreBinaries": ["encore", "stackra"],
    },
    // gen loads the member's own @stackra/database to compile its migrations (`require.resolve` from the member root,
    // stackra-248): the member declares it, gen must not, or gen would depend on a package it compiles for.
    "packages/developer/gen": {
      "entry": ["stackra.config.ts", ".stackra/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@stackra/database"],
    },
    // Packages only gen's .stackra output imports (registrations: outbox, queue, scheduler; wiring: actions, content,
    // database), declared for it (generated_dependency_missing).
    // shortcut: gen writes no .stackra for these members while shim_authored refuses them; drop these blocks once
    // stackra-163 lands and the .stackra entries above see the imports.
    "packages/application/achievements": {
      "entry": ["stackra.config.ts", ".stackra/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@stackra/content", "@stackra/outbox"],
    },
    "packages/application/ai": {
      "entry": ["stackra.config.ts", ".stackra/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@stackra/outbox"],
    },
    "packages/application/segments": {
      "entry": ["stackra.config.ts", ".stackra/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@stackra/content", "@stackra/scheduler"],
    },
    "packages/commerce/loyalty-kit": {
      "entry": ["stackra.config.ts", ".stackra/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@stackra/outbox", "@stackra/queue", "@stackra/scheduler"],
    },
    "packages/communication/notifications": {
      "entry": ["stackra.config.ts", ".stackra/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@stackra/outbox"],
    },
    "packages/communication/webhooks": {
      "entry": ["stackra.config.ts", ".stackra/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@stackra/scheduler"],
    },
    "packages/data/documents": {
      "entry": ["stackra.config.ts", ".stackra/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@stackra/actions"],
    },
    "packages/experience/collaboration": {
      "entry": ["stackra.config.ts", ".stackra/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@stackra/outbox"],
    },
    "packages/runtime/workflow": {
      "entry": ["stackra.config.ts", ".stackra/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@stackra/outbox"],
    },
    "packages/security/access-log": {
      "entry": ["stackra.config.ts", ".stackra/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@stackra/outbox", "@stackra/queue", "@stackra/scheduler"],
    },
    "packages/security/entitlements": {
      "entry": ["stackra.config.ts", ".stackra/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@stackra/database"],
    },
    "packages/security/identity": {
      "entry": ["stackra.config.ts", ".stackra/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@stackra/outbox"],
    },
    "packages/security/scope": {
      "entry": ["stackra.config.ts", ".stackra/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@stackra/outbox"],
    },
    "apps/*": {
      // gen finds the root module by name (ADR 0294 R12); src/main.* is the stand-in entry until gen writes it; a
      // component folder's index.ts is its public surface (ADR 0294 decision 14).
      "entry": [
        "src/main.{ts,tsx}",
        "src/*.module.ts",
        "src/components/*/index.ts",
        ".stackra/**/*.{ts,tsx}",
      ],
      "project": ["src/**/*.{ts,tsx,css}"],
    },
    "apps/mobile": {
      // The design-system review area is reached through `__DEV__ ? require(...)` in the tab navigator, which knip
      // does not trace; these are its entry files.
      "entry": [
        "src/components/ui/component-page.tsx",
        "src/components/ui/display-settings.tsx",
        "src/screens/design-system-screen.tsx",
        ".stackra/**/*.{ts,tsx}",
      ],
      "project": ["src/**/*.{ts,tsx,css}"],
      // app.json turns OTA updates off until the app has an EAS project id; knip's expo plugin assumes them.
      // @babel/plugin-transform-flow-strip-types: babel.config.js resolves it through babel-preset-expo on purpose, so
      // the override runs the preset's own copy (Babel 7) and the app declares none.
      // expo-intent-launcher, expo-secure-store, expo-widgets, react-native-mmkv: native libraries of the app's packages
      // (i18n, storage, platform), declared only so Expo autolinks them (tools/scripts/app-native-deps.mjs, STA-1544);
      // the app never imports them itself. expo-tracking-transparency: the same for platform's ExpoSystemSettingsDriver,
      // which reads the App Tracking Transparency answer; the app carries no ATT plugin since it never prompts (STA-1587).
      // expo-status-bar: the app no longer imports it, but the mobile scaffold template does through the same
      // `catalog:mobile` entry, and knip ignores the templates; this keeps that entry named by a member.
      "ignoreDependencies": [
        "expo-status-bar",
        "expo-updates",
        "@babel/plugin-transform-flow-strip-types",
        "expo-intent-launcher",
        "expo-secure-store",
        "expo-tracking-transparency",
        "expo-widgets",
        "react-native-mmkv",
      ],
    },
    // @stackra/app: imported only by gen's `.stackra/entry/<runtime>.ts` (generated_dependency_missing without it).
    // shortcut: CI's knip runs without gen, so the .stackra entry is absent; drop this block once knip runs after gen
    // (the same shortcut as the packages blocks above).
    "apps/playground": {
      "entry": [
        "src/main.{ts,tsx}",
        "src/*.module.ts",
        "src/components/*/index.ts",
        ".stackra/**/*.{ts,tsx}",
      ],
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignoreDependencies": ["@stackra/app"],
    },
    "workers/*": {
      "project": ["src/**/*.ts"],
    },
    "services/*": {
      // gen finds the root module by name (ADR 0294 R12); a v2 service still names it in `stackra.module`.
      "entry": ["src/*.module.ts", ".stackra/**/*.{ts,tsx}"],
      "project": ["src/**/*.ts"],
    },
    "apps/docs": {
      // Pages are MDX; gen reads stackra.config.ts and src/config/docs.config.ts; scripts/ holds the system-map writer.
      "entry": ["stackra.config.ts", "src/config/docs.config.ts", "scripts/**/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"],
      // `stackra dev` and `stackra lint` run the member's own `mint` (cli resolve-tool), so no script names it.
      "ignoreDependencies": ["mint"],
    },
  },
  // `mint`: Swift's Mint runner, a fallback in lefthook's generated hooks.
  // Scaffold templates are inert text with {{tokens}}; the generated members are checked once they exist.
  // dist/ is build output (the tooling presets ship tsc-emitted JS and .d.ts); knip checks the src it is built from.
  // A hook's `*.returns.ts` is read by path by the showcase API generator (gen-api.ts), not imported.
  "ignore": [
    "tools/scaffold/templates/**",
    "**/__tests__/fixtures/**",
    "**/dist/**",
    "packages/design-system/ui/src/**/*.returns.ts",
    // A build box's untracked leftover, not a file of this repository.
    "workers/registry/src/http/handle-landing.ts",
  ],
  // Unlisted dependencies in gen's output only (stackra-247, ADR 0295 decision 5, ADR 0261): gen's
  // generated_dependency_missing and schema_dependency_missing already hold every @stackra/* (and a schemas file's
  // zod) import there, and the wiring leaves out a driver's constructor tokens from a library the member does not
  // declare (MikroORM of @stackra/database's postgres driver). The files stay entries, so the packages they do use
  // still count; only the `unlisted` report is skipped.
  // Duplicate exports in gen's output only (STA-1299): a schemas file exports a config's schema under the config's
  // name too (`RateLimitConfig$` beside `RateLimitOptions$`), the name a host's config override and the generated
  // entry barrels import; the two names are one schema by design.
  "ignoreIssues": {
    "**/.stackra/**": ["unlisted", "duplicates"],
  },
  // sips: macOS's image tool, which tools/scripts/brand-pull.mjs runs to rasterise a brand SVG (brand rules §32).
  "ignoreBinaries": ["gitleaks", "mint", "sips"],
  "rules": {
    // A catalog entry no member names is an error (rule-gap B-10, stackra-235): add the entry with its first consumer,
    // and drop it with the last one.
    "catalog": "error",
  },
  "includeEntryExports": false,
}
