// Stackra file contract:
// Purpose: root oxlint entry — extends the shared presets from packages/tooling/oxlint. `boundaries`
//          carries the tier dependency rule, so it applies repo-wide from here. Rules are never written in
//          this file; change the preset. Only repo-level ignores live here (a preset's ignorePatterns resolve
//          relative to the preset file, not the repo root).
// Owner: release-operations · Secrets: forbidden
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./packages/tooling/oxlint/src/boundaries.jsonc"],
  "ignorePatterns": [
    // oxlint follows workspace symlinks (apps/*/node_modules/@stackra/* → packages/*): a bare name pattern
    // is what stops the traversal.
    "node_modules",
    "**/node_modules/**",
    // generated
    "**/encore.gen/**",
    "**/dist/**",
    // Expo: generated native projects and the CLI cache
    "**/ios/**",
    "**/android/**",
    "**/.expo/**",
    "**/uniwind-types.d.ts",
    "**/coverage/**",
    "**/*.d.ts",
    "packages/*/api-client/src/generated/**",
    // scaffold templates hold {{TOKENS}}, so they are not valid TS; the generator formats what it renders
    "tools/scaffold/templates/**",
    // lint fixtures are banned imports on purpose; their test lints them with the preset directly
    "**/__tests__/fixtures/**",
    // installed skills are upstream content
    ".agents/skills/**",
    // fenced upstream Encore skills, read only by compiler-engineer (ADR 0258)
    ".agents/reference/**",
    ".claude/skills/**",
    // private owner-only notes submodule (STA-178); never part of this repo's checks
    ".notes/**",
  ],
}
