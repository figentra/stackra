# Stackra file contract:
# Purpose: what git never tracks — dependency trees, build output, Encore generated code, and local env.
# Owner: release-operations · Secrets: forbidden (the rules below are what keeps them out)

.DS_Store
node_modules/
dist/
**/dist/
coverage/
*.tsbuildinfo
.turbo/
*.log

# Encore — regenerated by the CLI, and the app `stackra gen` emits (ADR 0091/0124; only app-manifest.json is committed),
# at the root and in every member.
encore.gen/
.encore/
**/.stackra/*
!**/.stackra/app-manifest.json
# Gen's root Vitest shim of a package or service member (ADR 0295 decision 5; STA-1299). The authored configs that
# merge ./.stackra/vitest.config are tracked and stay tracked; add a new authored one with `git add -f`.
packages/*/*/vitest.config.ts
services/*/vitest.config.ts
# Gen's root Expo config shim of an app (ADR 0295 decision 5).
apps/*/app.config.ts
# A docs app's generated Mintlify root, in any member (ADR 0002, 2026-10-27 amendment).
**/.stackra/site/

# Secrets never live in files. Application secrets: `encore secret set`. Developer tokens: the vault.
.env
.env.*
**/.secrets.local.cue

# Wrangler local state (`wrangler dev`): miniflare storage and temporary bundles
.wrangler/

# Playwright
test-results/
playwright-report/

# Vite
*.local

# Local reference dumps and editor state
.ref/
*.code-workspace
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# pnpm content-addressable cache if a tool points it here
.cache/
.pnpm-store/

# Expo — native projects are generated by `expo prebuild` / `expo run:*`
.expo/
ios/
android/
# An Expo module package authors its ios/ and android/ (ADR 0478 decision 2).
!packages/*/*/ios/
!packages/*/*/android/
expo-env.d.ts

# Mintlify local preview cache
.mintlify/

# Claude Code worktrees
.claude/worktrees/
.claude/settings.local.json

# generated locally from .mcp.yaml by agents-sync
.mcp.json
