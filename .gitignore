# Stackra file contract:
# Purpose: what git never tracks — dependency trees, build output, Encore generated code, and local env.
# Owner: release-operations · Secrets: forbidden (the rules below are what keeps them out)

.DS_Store
node_modules/
dist/
**/dist/
coverage/
*.tsbuildinfo
.turbo/
*.log

# Encore — regenerated by the CLI
encore.gen/
.encore/

# Secrets never live in files. Application secrets: `encore secret set`. Developer tokens: the vault.
.env
.env.*
**/.secrets.local.cue

# Playwright
test-results/
playwright-report/

# Vite
*.local

# Local reference dumps and editor state
.ref/
*.code-workspace
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# pnpm content-addressable cache if a tool points it here
.cache/
.pnpm-store/

# Expo — native projects are generated by `expo prebuild` / `expo run:*`
.expo/
ios/
android/
expo-env.d.ts

# Mintlify local preview cache
.mintlify/

# Claude Code worktrees
.claude/worktrees/
.claude/settings.local.json
