// Stackra file contract:
// Purpose: oxfmt (formatter) settings and the list of generated/historic files that are never reformatted.
// Scope: repository-wide; runs on save (editor), on staged files (lefthook), and in CI (pnpm format:check).
// Owner: release-operations · Secrets: forbidden
// Change policy: adding an ignore pattern needs a reason in the comment next to it.
{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "ignorePatterns": [
    // rendered by `fflow sync`; .flow/lock.json pins their bytes (`fflow gate ci` fails on a reformatted file)
    ".agents/skills/**",
    ".agents/agents/**",
    // projected from .agents/agents by `fflow sync` (projection: true); `fflow check` names a hand edit
    ".claude/agents/**",
    ".opencode/agents/**",
    ".agents/rules/**",
    ".github/workflows/fflow-approve.yml",
    ".github/workflows/fflow-baseline.yml",
    "README.md",
    // also rendered by `fflow sync` 0.5.0 and digest-locked
    "AGENTS.md",
    "CLAUDE.md",
    ".agents/hooks/fflow-guard.mjs",
    ".opencode/plugins/fflow-guard.mjs",
    // written by `stackra gen:workspace` from the runways; formatting them by hand makes gen and oxfmt disagree
    ".vscode/tasks.json",
    ".claude/launch.json",
    "**/node_modules/**",
    "**/dist/**",
    // Expo: generated native projects and the CLI cache
    "**/ios/**",
    "**/android/**",
    "**/.expo/**",
    "**/uniwind-types.d.ts",
    "**/coverage/**",
    "**/encore.gen/**",
    // generated by tools, never hand-formatted
    "**/CHANGELOG.md",
    "pnpm-lock.yaml",
    // archify's rendering (stackra architecture-map); its browser check ran on these exact bytes
    "apps/docs/src/assets/architecture-map.html",
    // rendered locally from .mcp.yaml by `fflow sync` (gitignored); never hand-formatted
    ".mcp.json",
    // `encore gen client` output; compared byte-for-byte in CI
    "packages/*/api-client/src/generated/**",
    // a package's committed entity list, written by `stackra gen`; `gen --check` compares it byte-for-byte (STA-1874)
    "packages/*/*/src/node/entities.gen.ts",
    // scaffold templates hold {{TOKENS}}, so they are not valid TS; the generator formats what it renders
    "tools/scaffold/templates/**",
    // @stackra/tokens: theme CSS its tests compare byte-for-byte with the renderers, and brand-kit files vendored
    // byte-for-byte (packages/design-system/tokens/README.md)
    "packages/design-system/tokens/assets/**",
    // Stackra brand-kit assets, moved byte-for-byte from @stackra/brand (ADR 0302); all rights reserved
    "apps/docs/src/assets/brand/**",
    // installed skills are upstream content
    ".agents/skills/**",
    // fenced upstream Encore skills, read only by compiler-engineer (ADR 0258)
    ".agents/reference/**",
    ".claude/skills/**",
    // Figentra Flow output (lock, README) and the constitution
    ".flow/**",
    ".opencode/commands/**",
    // @stackra/flow-preset's content, kept byte for byte as moved from figentra/flow (STA-2097), which never
    // formats it: `fflow sync` renders it and .flow/lock.json pins its digest in every repository
    "packages/developer/flow-preset/preset/**",
    // private owner-only notes submodule (STA-178); never part of this repo's checks
    ".notes/**",
  ],
}
