# Stackra file contract:
# Purpose: pnpm behaviour every install honours. engine-strict refuses an unsupported Node; peers are
#          auto-installed so a workspace never carries a transitive peer by hand; hoisting stays off so a
#          package can only import what it declares.
# Owner: release-operations · Secrets: forbidden (no auth tokens here; registries authenticate via the vault)
engine-strict=true
auto-install-peers=true
shamefully-hoist=false
strict-peer-dependencies=false
