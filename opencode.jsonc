// Stackra file contract:
// Purpose: opencode (v2) project configuration for delegated runs (AGENTS.md):
//          the default model, the instructions file, and the permissions every run inherits. Agents live under
//          .opencode/agents (mirror .claude/agents).
// Owner: the owner (architecture decisions go to the owner) · Secrets: forbidden (no tokens here; Bedrock credentials come from the AWS profile)
{
  "$schema": "https://opencode.ai/config.json",
  "model": "amazon-bedrock/global.moonshotai.kimi-k3",
  "instructions": ["AGENTS.md"],
  // Same tiers as .claude/settings.json (ADR 0293). Unattended (ADR 0066) and `--auto` approves any ask, so ASK is
  // deny here. Rules run in order and the LAST matching rule wins, so broad allows come first and the denies after
  // them. The guard plugin (.opencode/plugins/guard) adds what patterns cannot express (runner wrappers, global git
  // options, own-worktree checks, rm -rf roots) from the rules shared with the Claude hooks (.agents/hooks/_rules.mjs).
  // Source: https://opencode.ai/v2/docs/permissions
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },

    // pnpm runs any PATH binary as a fallback: close it, reopen by name.
    { "action": "shell", "resource": "pnpm *", "effect": "deny" },
    { "action": "shell", "resource": "pnpm run *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm --filter *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm -F *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm install*", "effect": "allow" },
    { "action": "shell", "resource": "pnpm build*", "effect": "allow" },
    { "action": "shell", "resource": "pnpm typecheck*", "effect": "allow" },
    { "action": "shell", "resource": "pnpm lint*", "effect": "allow" },
    { "action": "shell", "resource": "pnpm format*", "effect": "allow" },
    { "action": "shell", "resource": "pnpm test*", "effect": "allow" },
    { "action": "shell", "resource": "pnpm check*", "effect": "allow" },
    { "action": "shell", "resource": "pnpm verify*", "effect": "allow" },
    { "action": "shell", "resource": "pnpm validate*", "effect": "allow" },
    { "action": "shell", "resource": "pnpm boundaries*", "effect": "allow" },
    { "action": "shell", "resource": "pnpm knip*", "effect": "allow" },
    { "action": "shell", "resource": "pnpm new *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm agents:check*", "effect": "allow" },
    { "action": "shell", "resource": "pnpm spec:gate*", "effect": "allow" },
    { "action": "shell", "resource": "pnpm spec:trace*", "effect": "allow" },
    { "action": "shell", "resource": "pnpm * exec *", "effect": "deny" },
    { "action": "shell", "resource": "pnpm exec *", "effect": "deny" },
    { "action": "shell", "resource": "pnpm * dlx *", "effect": "deny" },
    { "action": "shell", "resource": "pnpm dlx *", "effect": "deny" },
    { "action": "shell", "resource": "npx *", "effect": "deny" },
    { "action": "shell", "resource": "pnpx *", "effect": "deny" },
    { "action": "shell", "resource": "npm exec *", "effect": "deny" },
    { "action": "shell", "resource": "pnpm exec oxfmt *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm exec oxlint *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm exec vitest *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm exec tsc *", "effect": "allow" },
    // The scripts these run hold the full /agents set: the lead's, except the executor's own push (below). A leading
    // `*` also catches an environment prefix (`NODE_OPTIONS=… pnpm bot:git …`), which the allows below never match.
    { "action": "shell", "resource": "*pnpm *bot:*", "effect": "deny" },
    { "action": "shell", "resource": "pnpm *pr:merge*", "effect": "deny" },
    { "action": "shell", "resource": "pnpm *linear*", "effect": "deny" },
    { "action": "shell", "resource": "pnpm *secrets:*", "effect": "deny" },
    { "action": "shell", "resource": "pnpm *changeset*", "effect": "deny" },
    { "action": "shell", "resource": "pnpm *publish*", "effect": "deny" },
    { "action": "shell", "resource": "pnpm *delegate*", "effect": "deny" },

    // Secret values and the owner's credentials (files).
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.dev.vars", "effect": "deny" },
    { "action": "read", "resource": "*.secrets.local.*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "~/.git-credentials", "effect": "deny" },
    { "action": "read", "resource": "~/.npmrc", "effect": "deny" },
    { "action": "read", "resource": "~/.netrc", "effect": "deny" },
    { "action": "read", "resource": "~/.docker/config.json", "effect": "deny" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "~/Secrets-inbox*", "effect": "deny" },
    { "action": "edit", "resource": "~/Secrets-inbox*", "effect": "deny" },
    { "action": "glob", "resource": "*Secrets-inbox*", "effect": "deny" },
    { "action": "grep", "resource": "*Secrets-inbox*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/Secrets-inbox*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.config/gh*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.ssh*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.aws*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.wrangler*", "effect": "deny" },
    {
      "action": "external_directory",
      "resource": "~/Library/Preferences/.wrangler*",
      "effect": "deny",
    },
    { "action": "external_directory", "resource": "~/.expo*", "effect": "deny" },
    {
      "action": "external_directory",
      "resource": "~/Library/Application Support/encore*",
      "effect": "deny",
    },

    // Secret values and the owner's credentials (shell). Executors never need Infisical or the keychain.
    { "action": "shell", "resource": "infisical*", "effect": "deny" },
    { "action": "shell", "resource": "*secrets-import*", "effect": "deny" },
    { "action": "shell", "resource": "node *bot-token*", "effect": "deny" },
    { "action": "shell", "resource": "printenv*", "effect": "deny" },
    { "action": "shell", "resource": "env", "effect": "deny" },
    { "action": "shell", "resource": "security *", "effect": "deny" },
    { "action": "shell", "resource": "gh", "effect": "deny" },
    { "action": "shell", "resource": "gh *", "effect": "deny" },
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "git fetch*", "effect": "deny" },
    { "action": "shell", "resource": "git pull*", "effect": "deny" },
    { "action": "shell", "resource": "git clone*", "effect": "deny" },
    { "action": "shell", "resource": "git ls-remote*", "effect": "deny" },
    { "action": "shell", "resource": "git remote update*", "effect": "deny" },
    { "action": "shell", "resource": "git submodule*", "effect": "deny" },
    { "action": "shell", "resource": "git submodule status*", "effect": "allow" },
    { "action": "shell", "resource": "git submodule summary*", "effect": "allow" },
    { "action": "shell", "resource": "git subtree*", "effect": "deny" },
    { "action": "shell", "resource": "git credential*", "effect": "deny" },

    // Shared local state (the main-checkout and own-worktree checks live in the plugin).
    { "action": "shell", "resource": "git stash pop*", "effect": "deny" },
    { "action": "shell", "resource": "git stash clear*", "effect": "deny" },
    { "action": "shell", "resource": "git stash branch*", "effect": "deny" },
    { "action": "shell", "resource": "git stash drop*", "effect": "deny" },
    { "action": "shell", "resource": "git branch -D*", "effect": "deny" },
    { "action": "shell", "resource": "git branch * -D*", "effect": "deny" },
    { "action": "shell", "resource": "git worktree remove*", "effect": "deny" },
    { "action": "shell", "resource": "git worktree prune*", "effect": "deny" },
    { "action": "shell", "resource": "git reflog expire*", "effect": "deny" },
    { "action": "shell", "resource": "git reflog delete*", "effect": "deny" },
    { "action": "shell", "resource": "docker compose *down*-v*", "effect": "deny" },
    { "action": "shell", "resource": "docker compose *--volumes*", "effect": "deny" },

    // Deploy, publish, remote cloud (Claude's ASK tier).
    { "action": "shell", "resource": "changeset *", "effect": "deny" },
    { "action": "shell", "resource": "npm publish*", "effect": "deny" },
    { "action": "shell", "resource": "npm * publish*", "effect": "deny" },
    { "action": "shell", "resource": "encore deploy*", "effect": "deny" },
    { "action": "shell", "resource": "encore secret*", "effect": "deny" },
    { "action": "shell", "resource": "encore env set*", "effect": "deny" },
    { "action": "shell", "resource": "encore env create*", "effect": "deny" },
    { "action": "shell", "resource": "encore env delete*", "effect": "deny" },
    { "action": "shell", "resource": "encore db reset*", "effect": "deny" },
    { "action": "shell", "resource": "wrangler *deploy*", "effect": "deny" },
    { "action": "shell", "resource": "wrangler rollback*", "effect": "deny" },
    { "action": "shell", "resource": "wrangler *delete*", "effect": "deny" },
    { "action": "shell", "resource": "wrangler secret*", "effect": "deny" },
    { "action": "shell", "resource": "wrangler *--remote*", "effect": "deny" },
    { "action": "shell", "resource": "eas *", "effect": "deny" },

    // No remote host by shell in unattended runs; test local services with `pnpm test`.
    { "action": "shell", "resource": "curl*", "effect": "deny" },
    { "action": "shell", "resource": "wget*", "effect": "deny" },

    // Phase 2 (ADR 0293, amending ADR 0066): an executor fetches origin, and pushes its own feature branch, as the
    // bot. The plugin keeps the push off main and off every other branch, and denies options that run a program.
    { "action": "shell", "resource": "pnpm bot:git -- fetch origin", "effect": "allow" },
    { "action": "shell", "resource": "pnpm bot:git -- fetch origin *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm bot:git -- push origin HEAD", "effect": "allow" },
    {
      "action": "shell",
      "resource": "pnpm bot:git -- push --force-with-lease origin HEAD",
      "effect": "allow",
    },
  ],
}
