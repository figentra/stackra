{
  "name": "stackra",
  "version": "0.0.0",
  "private": true,
  "description": "Stackra — pnpm + Turborepo monorepo: @stackra/* packages by category, apps (console, docs, mobile) and reference services; Encore is generated by stackra gen.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install && node tools/scripts/agents-sync.mjs --mcp-only",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "gen": "node packages/developer/cli/dist/stackra.mjs gen",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && pnpm lint:root",
    "lint:root": "oxlint tools/scripts .agents/hooks .opencode/plugins",
    "format": "oxfmt --write . && git ls-files -z '*.sh' ':!.specify/**' | xargs -0 shfmt -w",
    "format:check": "oxfmt --check . && git ls-files -z '*.sh' ':!.specify/**' | xargs -0 shfmt -d",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage --filter='./packages/**'",
    "test:int": "turbo run test:int",
    "check": "pnpm format:check && turbo run lint typecheck && pnpm lint:root",
    "verify": "pnpm format:check && turbo run lint typecheck test build && pnpm lint:root && pnpm validate && pnpm boundaries && pnpm knip",
    "verify:affected": "pnpm format:check && turbo run lint typecheck test build --affected",
    "test:hooks": "node --test .agents/hooks/__tests__/*.test.mjs .opencode/plugins/guard/__tests__/*.test.ts",
    "validate": "node --test tools/scripts/__tests__/*.test.mjs && node tools/scripts/validate-repository.mjs && node tools/scripts/doc-standard.mjs && node tools/scripts/spec-gate.mjs ci && node tools/scripts/spec-trace.mjs ci && node tools/scripts/duplication.mjs && pnpm test:hooks && pnpm agents:check",
    "new": "node tools/scripts/scaffold.mjs",
    "boundaries": "turbo boundaries",
    "knip": "knip",
    "console": "turbo run dev --filter=@figentra/console",
    "docs": "turbo run dev --filter=@figentra/docs",
    "mobile": "turbo run dev --filter=@figentra/mobile",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "secrets:scan": "gitleaks git . --config .gitleaks.toml --no-banner --redact",
    "delegate": "node tools/scripts/delegate.mjs",
    "linear": "infisical run --env=dev --path=/agents --silent -- node tools/scripts/linear.mjs",
    "spec:linear": "infisical run --env=dev --path=/agents --silent -- node tools/scripts/spec-linear.mjs",
    "ai:spend": "node tools/scripts/ai-spend.mjs",
    "doctor": "node tools/scripts/doctor.mjs",
    "agents:sync": "node tools/scripts/agents-sync.mjs",
    "agents:check": "node tools/scripts/agents-sync.mjs --check",
    "speckit:sync": "node tools/scripts/speckit-sync.mjs",
    "spec:gate": "node tools/scripts/spec-gate.mjs",
    "spec:trace": "node tools/scripts/spec-trace.mjs",
    "secrets:import": "node tools/scripts/secrets-import.mjs",
    "runway": "node tools/scripts/runway.mjs",
    "bot:token": "infisical run --env=dev --path=/agents --silent -- node tools/scripts/bot-token.mjs",
    "bot:gh": "infisical run --env=dev --path=/agents --silent -- node tools/scripts/bot-gh.mjs gh",
    "bot:git": "infisical run --env=dev --path=/agents --silent -- node tools/scripts/bot-gh.mjs git",
    "bot:review": "infisical run --env=dev --path=/agents --silent -- node tools/scripts/bot-gh.mjs review",
    "pr:merge": "infisical run --env=dev --path=/agents --silent -- node tools/scripts/pr-merge.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-git": "catalog:release",
    "@changesets/cli": "catalog:release",
    "@commitlint/cli": "catalog:release",
    "@stackra/commitlint-config": "workspace:*",
    "@types/node": "catalog:",
    "jscpd": "catalog:quality",
    "knip": "catalog:quality",
    "lefthook": "catalog:release",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "turbo": "catalog:build",
    "typescript": "catalog:tooling",
    "undici": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.6.0"
}
