{
  "name": "stackra",
  "version": "0.0.0",
  "private": true,
  "description": "Stackra — pnpm + Turborepo monorepo: @stackra/* packages by category, apps (console, docs, mobile) and reference services; Encore is generated by stackra gen.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "{ [ -n \"$CI\" ] || ! d=$(git rev-parse --path-format=absolute --git-dir 2>/dev/null) || [ \"$d\" != \"$(git rev-parse --path-format=absolute --git-common-dir)\" ] || lefthook install; } && if [ -z \"$CI\" ]; then fflow sync >/dev/null; fi",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "gen": "turbo run gen:workspace gen",
    "gen:workspace": "node packages/developer/cli/dist/stackra.mjs gen",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && pnpm lint:root",
    "lint:root": "oxlint tools/scripts .agents/hooks .opencode/plugins",
    "format": "oxfmt --write . && git ls-files -z '*.sh' ':!.flow/**' | xargs -0 shfmt -w",
    "format:check": "oxfmt --check . && git ls-files -z '*.sh' ':!.flow/**' | xargs -0 shfmt -d",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage --filter='./packages/**'",
    "test:int": "turbo run test:int",
    "check": "pnpm format:check && turbo run lint typecheck && pnpm lint:root",
    "verify": "pnpm format:check && turbo run lint typecheck test build && pnpm lint:root && pnpm validate && pnpm boundaries && pnpm knip",
    "verify:affected": "pnpm format:check && turbo run lint typecheck test build --affected",
    "test:hooks": "node --test .agents/hooks/__tests__/*.test.mjs .opencode/plugins/guard/__tests__/*.test.ts",
    "validate": "node --test tools/scripts/__tests__/*.test.mjs && node packages/developer/cli/dist/stackra.mjs validate --repository && node packages/developer/cli/dist/stackra.mjs doc-standard && fflow gate ci && fflow trace ci && node packages/developer/cli/dist/stackra.mjs duplication && pnpm test:hooks",
    "new": "node packages/developer/cli/dist/stackra.mjs new",
    "boundaries": "turbo boundaries",
    "knip": "knip",
    "console": "turbo run dev --filter=@figentra/console",
    "docs": "turbo run dev --filter=@figentra/docs",
    "mobile": "turbo run dev --filter=@figentra/mobile",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version && pnpm install --lockfile-only && turbo run gen:workspace gen --output-logs=errors-only",
    "secrets:scan": "gitleaks git . --config .gitleaks.toml --no-banner --redact",
    "delegate": "node tools/scripts/delegate.mjs",
    "linear": "node tools/scripts/secrets-exec.mjs --names LINEAR_AGENT_TOKEN,LINEAR_AGENT_CLIENT_ID,LINEAR_AGENT_CLIENT_SECRET,LINEAR_API_KEY -- node tools/scripts/linear.mjs",
    "spec:linear": "node tools/scripts/secrets-exec.mjs --names LINEAR_AGENT_TOKEN,LINEAR_AGENT_CLIENT_ID,LINEAR_AGENT_CLIENT_SECRET,LINEAR_API_KEY -- fflow linear",
    "ai:spend": "node tools/scripts/ai-spend.mjs",
    "doctor": "node packages/developer/cli/dist/stackra.mjs doctor",
    "eas:preflight": "node packages/developer/cli/dist/stackra.mjs eas-preflight",
    "spec:sync": "fflow sync",
    "spec:gate": "fflow gate",
    "spec:trace": "fflow trace",
    "secrets:import": "node tools/scripts/secrets-import.mjs",
    "secrets:put": "node tools/scripts/secrets-put.mjs",
    "secrets:generate": "node tools/scripts/secrets-generate.mjs",
    "secrets:rotate": "node tools/scripts/secrets-generate.mjs --rotate",
    "secrets:catalog": "node tools/scripts/secrets-catalog.mjs",
    "secrets:age-init": "node tools/scripts/secrets-age-init.mjs",
    "store": "node tools/scripts/store.mjs",
    "runway": "node packages/developer/runway/dist/runway.mjs",
    "bot:token": "node tools/scripts/secrets-exec.mjs --names STACKRA_BOT_APP_ID,STACKRA_BOT_INSTALLATION_ID,STACKRA_BOT_PRIVATE_KEY -- node tools/scripts/bot-token.mjs",
    "bot:gh": "node tools/scripts/secrets-exec.mjs --names STACKRA_BOT_APP_ID,STACKRA_BOT_INSTALLATION_ID,STACKRA_BOT_PRIVATE_KEY -- node tools/scripts/bot-gh.mjs gh",
    "bot:git": "node tools/scripts/secrets-exec.mjs --names STACKRA_BOT_APP_ID,STACKRA_BOT_INSTALLATION_ID,STACKRA_BOT_PRIVATE_KEY -- node tools/scripts/bot-gh.mjs git",
    "pr:merge": "node tools/scripts/secrets-exec.mjs --names STACKRA_BOT_APP_ID,STACKRA_BOT_INSTALLATION_ID,STACKRA_BOT_PRIVATE_KEY -- node tools/scripts/pr-merge.mjs",
    "adr:reserve": "node tools/scripts/secrets-exec.mjs --names STACKRA_BOT_APP_ID,STACKRA_BOT_INSTALLATION_ID,STACKRA_BOT_PRIVATE_KEY -- node tools/scripts/adr-reserve.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-git": "catalog:release",
    "@changesets/cli": "catalog:release",
    "@commitlint/cli": "catalog:release",
    "@figentra-oss/flow": "catalog:",
    "@stackra/commitlint-config": "workspace:*",
    "@stackra/flow-preset": "workspace:*",
    "@types/node": "catalog:",
    "jscpd": "catalog:quality",
    "knip": "catalog:quality",
    "lefthook": "catalog:release",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "sharp": "catalog:media",
    "turbo": "catalog:build",
    "typescript": "catalog:tooling",
    "undici": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.16.1",
  "stackra": {
    "layout": {
      "allow": {
        ".gitmodules": "the private .notes submodule",
        ".notes": "the private owner-only notes submodule",
        "THIRD_PARTY_NOTICES.md": "the notices of code the published packages carry",
        "TRADEMARKS.md": "the Stackra trademark policy of the public framework",
        "apps": "the published docs site and the console and mobile reference apps (ADR 0526 d2, d3)"
      }
    }
  }
}
