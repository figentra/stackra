{
  "name": "stackra",
  "version": "0.0.0",
  "private": true,
  "description": "Stackra — pnpm + Turborepo monorepo: @stackra/* packages by category, apps (console, docs), the Encore app.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage --filter='./packages/**'",
    "check": "turbo run format:check lint typecheck",
    "verify": "turbo run format:check lint typecheck test build && pnpm validate && pnpm boundaries && pnpm knip",
    "verify:affected": "turbo run format:check lint typecheck test build --affected",
    "test:hooks": "node --test .agents/hooks/__tests__/*.test.mjs .opencode/plugins/guard/__tests__/*.test.ts",
    "validate": "node --test tools/scripts/__tests__/*.test.mjs && node tools/scripts/validate-repository.mjs && node tools/scripts/spec-gate.mjs ci && pnpm test:hooks && pnpm agents:check",
    "new": "node tools/scripts/scaffold.mjs",
    "boundaries": "turbo boundaries",
    "knip": "knip",
    "console": "turbo run dev --filter=@figentra/console",
    "docs": "turbo run dev --filter=@figentra/docs",
    "mobile": "turbo run dev --filter=@figentra/mobile",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "secrets:scan": "gitleaks git . --config .gitleaks.toml --no-banner --redact",
    "delegate": "node tools/scripts/delegate.mjs",
    "linear": "infisical run --env=dev --path=/agents --silent -- node tools/scripts/linear.mjs",
    "ai:spend": "node tools/scripts/ai-spend.mjs",
    "doctor": "node tools/scripts/doctor.mjs",
    "agents:sync": "node tools/scripts/agents-sync.mjs",
    "agents:check": "node tools/scripts/agents-sync.mjs --check",
    "speckit:sync": "specify integration use opencode && specify integration use claude && chmod +x .specify/scripts/bash/*.sh",
    "bot:token": "infisical run --env=dev --path=/agents --silent -- node tools/scripts/bot-token.mjs",
    "bot:gh": "infisical run --env=dev --path=/agents --silent -- node tools/scripts/bot-gh.mjs gh",
    "bot:git": "infisical run --env=dev --path=/agents --silent -- node tools/scripts/bot-gh.mjs git",
    "pr:merge": "infisical run --env=dev --path=/agents --silent -- node tools/scripts/pr-merge.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-git": "catalog:release",
    "@changesets/cli": "catalog:release",
    "@commitlint/cli": "catalog:release",
    "@commitlint/config-conventional": "catalog:release",
    "@types/node": "catalog:",
    "knip": "catalog:quality",
    "lefthook": "catalog:release",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "turbo": "catalog:build"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.6.0"
}
