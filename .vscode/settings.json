// Workspace settings: one formatter (oxfmt) and one linter (oxlint) through the Oxc extension, the
// repo's TypeScript, schemas for every config file, and the .editorconfig rules. Prettier and ESLint
// are off (rejected). Personal preferences (theme, font, keybindings) belong in user settings.
{
  // ── Format: oxfmt on save, for every language it owns ─────────────────────────────────────────
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.rulers": [100],
  "prettier.enable": false,
  "eslint.enable": false,
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[json]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[yaml]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[css]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[markdown]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    // .editorconfig keeps trailing whitespace in Markdown (hard line breaks).
    "files.trimTrailingWhitespace": false
  },
  "[mdx]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[toml]": { "editor.defaultFormatter": "tamasfe.even-better-toml" },

  // ── Lint: oxlint (config .oxlintrc.jsonc), fixes on save ───────────────────────────────────────
  "oxc.enable": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },

  // ── .editorconfig ───────────────────────────────────────────────────────────────────────────
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,

  // ── TypeScript: the repo's version, project-relative imports, `#` subpath imports ──────────────
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",

  // ── JSON with comments: trailing commas are allowed (oxfmt writes them) ───────────────────────
  "files.associations": {
    "*.jsonc": "jsonc",
    "turbo.jsonc": "jsonc",
    ".oxlintrc.jsonc": "jsonc",
    ".oxfmtrc.jsonc": "jsonc",
    "**/tsconfig*.json": "jsonc",
    "**/.vscode/*.json": "jsonc",
    "*.mdx": "mdx"
  },
  // Remote $schema URLs load only from trusted hosts (VS Code shows "Location ... is untrusted"
  // otherwise). Local paths (./node_modules, ./tools/schemas) need no entry.
  "json.schemaDownload.enable": true,
  "json.schemaDownload.trustedDomains": {
    "https://json.schemastore.org/": true,
    "https://www.schemastore.org/": true,
    "https://unpkg.com/": true,
    "https://cdn.jsdelivr.net/": true,
    "https://raw.githubusercontent.com/": true,
    "https://turborepo.com/": true,
    "https://turbo.build/": true,
    "https://turborepo.dev/": true,
    "https://biomejs.dev/": true,
    "https://mintlify.com/": true,
    "https://opencode.ai/": true,
    "https://schemas.stackra.figentra.com/": true
  },
  // A file's own `$schema` wins over these mappings, so they cover only files that carry none.
  "json.schemas": [
    // JSONC files: oxfmt writes trailing commas, so the JSON service must accept them.
    {
      "fileMatch": ["*.jsonc", "**/tsconfig*.json", "**/.vscode/*.json"],
      "schema": { "allowTrailingCommas": true }
    },
    // Claude Code's preview servers (.claude/launch.json), from SchemaStore.
    {
      "fileMatch": ["**/.claude/launch.json"],
      "url": "https://www.schemastore.org/claude-code-launch.json"
    },
    // tsconfig presets have no tsconfig*.json name, so VS Code would not recognise them.
    {
      "fileMatch": ["**/packages/tooling/typescript/src/*.json"],
      "url": "https://www.schemastore.org/tsconfig.json"
    },
    // oxlint presets: the installed oxlint's own schema (local file, no download or trust prompt).
    {
      "fileMatch": ["**/packages/tooling/oxlint/src/*.jsonc"],
      "url": "./node_modules/oxlint/configuration_schema.json"
    },
    // Expo app config, pinned to SDK 57 (the catalog's expo). The scaffold copy holds {{placeholders}}.
    {
      "fileMatch": ["**/apps/*/app.json"],
      "url": "https://www.schemastore.org/expo-57.0.0.json"
    },
    // EAS build profiles: eas-cli publishes one schema on main (eas-cli is not a workspace dependency).
    {
      "fileMatch": ["**/apps/*/eas.json", "**/tools/scaffold/templates/apps/mobile/eas.json"],
      "url": "https://raw.githubusercontent.com/expo/eas-cli/main/packages/eas-json/schema/eas.schema.json"
    },
    // Stackra's own schema; mapped here so the GitHub API payload carries no $schema key.
    {
      "fileMatch": ["**/.github/branch-protection.json"],
      "url": "./tools/schemas/branch-protection.schema.json"
    }
  ],

  // ── YAML: schemas for the config files that have one ──────────────────────────────────────────
  // A `# yaml-language-server: $schema=` comment in a file wins over these mappings. SchemaStore
  // stays on as a fallback for files listed nowhere.
  "yaml.format.enable": false,
  "yaml.validate": true,
  "yaml.schemaStore.enable": true,
  "yaml.schemas": {
    // Installed tools: the package's own schema file, so it matches the pinned version exactly.
    "./node_modules/lefthook/schema.json": "lefthook.yml",
    // Stackra's own schemas (tools/schemas; their $id is schemas.stackra.figentra.com, not hosted yet).
    "./tools/schemas/mcp.schema.json": ".mcp.yaml",
    // Tools without a workspace package: the tool's own published schema.
    "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json": ".markdownlint.yaml",
    "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/packages/cspell-types/cspell.schema.json": "cspell.config.yaml",
    // electron-builder's own schema (SchemaStore's copy predates the `universal` arch).
    "https://unpkg.com/app-builder-lib@26/scheme.json": "**/electron-builder.yml",
    // SchemaStore.
    "https://json.schemastore.org/commitlintrc.json": ".commitlintrc.yaml",
    "https://json.schemastore.org/pnpm-workspace.json": "pnpm-workspace.yaml",
    "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.yml"
  },

  // ── TOML: Even Better TOML (keys are regexes on the file URI; files also carry `#:schema`) ────────
  "evenBetterToml.schema.associations": {
    // mise publishes its own schema; gitleaks has one on SchemaStore.
    ".*/mise\\.toml$": "https://mise.jdx.dev/schema/mise.json",
    ".*/\\.gitleaks\\.toml$": "https://www.schemastore.org/gitleaks.json"
  },

  // ── Tailwind v4 / Uniwind class names in className, cn() and tv() ─────────────────────────────
  "tailwindCSS.experimental.classRegex": [
    ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*)[\"'`]"],
    ["tv\\(([^)]*)\\)", "[\"'`]([^\"'`]*)[\"'`]"]
  ],
  "tailwindCSS.classAttributes": ["class", "className", "classNames"],

  // ── i18n: assets/lang/<locale>/<namespace>.json in every member ───────────────────────────────
  "i18n-ally.localesPaths": [
    "apps/*/assets/lang",
    "services/*/assets/lang",
    "packages/*/*/assets/lang"
  ],
  "i18n-ally.pathMatcher": "{locale}/{namespaces}.json",
  "i18n-ally.namespace": true,
  "i18n-ally.keystyle": "nested",
  "i18n-ally.sourceLanguage": "en",
  "i18n-ally.displayLanguage": "en",
  "i18n-ally.enabledFrameworks": ["general"],

  // ── Markdown: oxfmt formats, markdownlint checks structure (rules in .markdownlint.yaml) ────────
  "markdown.validate.enabled": true,

  // ── Tests ──────────────────────────────────────────────────────────────────────────────────
  "playwright.reuseBrowser": true,

  // ── Explorer: nest generated and companion files under their source ───────────────────────────
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "pnpm-workspace.yaml, pnpm-lock.yaml, turbo.jsonc, knip.jsonc, .npmrc, mise.toml, .node-version",
    ".oxlintrc.jsonc": ".oxfmtrc.jsonc, .editorconfig, .gitattributes, .gitleaks.toml",
    "lefthook.yml": ".commitlintrc.yaml, cspell.config.yaml",
    "README.md": "CONTRIBUTING.md, SECURITY.md, LICENSE, NOTICE, AGENTS.md, CLAUDE.md"
  },

  // ── Search and watching: skip build output and caches ────────────────────────────────────────
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.turbo/**": true,
    "**/coverage/**": true,
    "**/.expo/**": true,
    "**/.stackra/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.turbo": true,
    "**/coverage": true,
    "pnpm-lock.yaml": true
  },

  // ── Git: the repo's own hooks run through lefthook ─────────────────────────────────────────────
  "git.allowNoVerifyCommit": false,
  "git.branchProtection": ["main"],
  "git.branchProtectionPrompt": "alwaysPrompt"
}
