{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "{{TITLE}}",
  "description": "{{DESCRIPTION}}",
  "colors": {
    "primary": "#4F46E5",
    "light": "#818CF8",
    "dark": "#4338CA"
  },
  "favicon": "/assets/favicon.svg",
  "logo": {
    "light": "/assets/logo/light.svg",
    "dark": "/assets/logo/dark.svg",
    "href": "/"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "search": {
    "prompt": "Search the {{TITLE}} docs"
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "{{TITLE}}"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "This page moved or never existed. Try search."
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart"]
          }
        ]
      }
    ]
  }
}
