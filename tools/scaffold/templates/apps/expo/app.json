{
  "expo": {
    "name": "{{TITLE}}",
    "slug": "{{NAME}}",
    "scheme": "stackra-{{NAME}}",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.figentra.stackra.{{NAME}}",
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.figentra.stackra.{{NAME}}",
      "predictiveBackGestureEnabled": false
    },
    "web": { "bundler": "metro" },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        { "backgroundColor": "#FFFFFF", "dark": { "backgroundColor": "#000000" } }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
