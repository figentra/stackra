{
  "name": "@figentra/service-{{NAME}}",
  "version": "0.0.0",
  "private": true,
  "description": "{{DESCRIPTION}}",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ],
    "#config/*": [
      "./src/config/*",
      "./src/config/*.ts",
      "./src/config/*.tsx",
      "./src/config/*/index.ts"
    ],
    "#contracts/*": [
      "./src/contracts/*",
      "./src/contracts/*.ts",
      "./src/contracts/*.tsx",
      "./src/contracts/*/index.ts"
    ],
    "#modules/*": [
      "./src/modules/*",
      "./src/modules/*.ts",
      "./src/modules/*.tsx",
      "./src/modules/*/index.ts"
    ],
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "devDependencies": {
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  }
}
