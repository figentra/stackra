{
  "name": "@stackra/{{NAME}}",
  "version": "0.0.0",
  "private": true,
  "description": "{{DESCRIPTION}}",
  "license": "MIT",
  "files": [
    "src",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#core": "./src/core/index.ts",
    "#core/*": "./src/core/*.ts",
    "#application": "./src/application/index.ts",
    "#application/*": "./src/application/*.ts",
    "#infrastructure": "./src/infrastructure/index.ts",
    "#infrastructure/*": "./src/infrastructure/*.ts",
    "#presentation/api": "./src/presentation/api/index.ts",
    "#presentation/api/*": "./src/presentation/api/*.ts"
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./core": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/core.d.mts",
      "default": "./dist/core.mjs"
    },
    "./application": {
      "@stackra/source": "./src/application/index.ts",
      "types": "./dist/application.d.mts",
      "default": "./dist/application.mjs"
    },
    "./infrastructure": {
      "@stackra/source": "./src/infrastructure/index.ts",
      "types": "./dist/infrastructure.d.mts",
      "default": "./dist/infrastructure.mjs"
    },
    "./presentation/api": {
      "@stackra/source": "./src/presentation/api/index.ts",
      "types": "./dist/presentation/api.d.mts",
      "default": "./dist/presentation/api.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "devDependencies": {
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  }
}
