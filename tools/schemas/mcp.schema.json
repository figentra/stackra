{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.stackra.figentra.com/mcp.json",
  "title": ".mcp.yaml",
  "description": "Every MCP server the project uses, in one file (ADR 0282). Rendered into the gitignored .mcp.json. Server definitions only, never a token: `$NAME` placeholders are injected at run time (ADR 0173).",
  "type": "object",
  "additionalProperties": false,
  "required": ["mcpServers"],
  "properties": {
    "$schema": { "type": "string" },
    "mcpServers": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": {
        "oneOf": [{ "$ref": "#/$defs/stdio" }, { "$ref": "#/$defs/remote" }]
      }
    }
  },
  "$defs": {
    "noSecretValue": {
      "type": "string",
      "description": "A literal or a `$NAME` placeholder; never a secret value."
    },
    "stdio": {
      "type": "object",
      "description": "A local server started as a process.",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "type": { "const": "stdio" },
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "$ref": "#/$defs/noSecretValue" } },
        "env": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/noSecretValue" }
        },
        "cwd": { "type": "string" }
      }
    },
    "remote": {
      "type": "object",
      "description": "A remote server; signs in with OAuth on first use.",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": { "enum": ["http", "sse"] },
        "url": { "type": "string", "pattern": "^https?://" },
        "headers": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/noSecretValue" }
        }
      }
    }
  }
}
