// Stackra file contract:
// Purpose: the workspace task graph (Turborepo) and the tier boundaries. `pnpm build|test|typecheck` fan out
//          through here. Named .jsonc so this file can carry comments; every non-obvious choice has one.
// Scope: every workspace.
// Owner: release-operations
// Secrets: forbidden — TURBO_TOKEN/TURBO_TEAM come from the environment (CI: vault; local: optional).
// Change policy: a new task name here needs the matching script in every workspace of that shape
//                (tools/scripts/validate-repository.mjs enforces the set).
{
  "$schema": "https://turborepo.dev/schema.json",

  // Remote cache: active when TURBO_TOKEN/TURBO_TEAM are present; a no-op otherwise. `signature: true`
  // HMAC-signs every uploaded artifact (key: TURBO_REMOTE_CACHE_SIGNATURE_KEY, from the vault) so a
  // poisoned cache entry is rejected rather than handed to every developer and CI run.
  "remoteCache": { "enabled": true, "signature": true },

  "ui": "tui",

  // Strict env mode: a task only sees the env vars it declares. Trades a little friction for cache
  // correctness — a task can no longer produce a different result for a reason its cache key misses.
  "envMode": "strict",

  "cacheMaxAge": "7d",
  "cacheMaxSize": "10GB",

  // Anything that changes the meaning of every task's output. mise.toml pins node/pnpm; a bump there can
  // change what every build/test/typecheck produces.
  "globalDependencies": ["mise.toml", "pnpm-workspace.yaml", ".oxlintrc.jsonc", ".oxfmtrc.jsonc"],

  "globalEnv": ["NODE_ENV", "CI"],

  // Vars a task may read without them entering its cache key — they affect HOW a tool runs, never WHAT it
  // produces. ENCORE_* are the Encore CLI's own runtime variables.
  "globalPassThroughEnv": ["HOME", "PATH", "ENCORE_*", "TURBO_*", "DOCKER_HOST"],

  // Boundaries: the dependency direction from packages/tooling/oxlint/src/boundaries.jsonc.
  //   tier:config  — tooling presets; depend on nothing workspace-local
  //   tier:lib     — packages/*/*; never depend on a deployable
  //   tier:app     — apps/* and workers/* (ADR 0284); consume config and libs, talk to services over the wire only
  //   tier:service — services/*; top of the graph
  // Each member declares its tags in its own turbo.jsonc: exactly one tier tag matching its directory, then
  // `category:<c>` (packages only) and `runtime:<r>` per entry of its package.json `stackra.runtimes`
  // (ADR 0453 decision 11, amendment of 2026-10-27). validate-repository checks both; only tier tags have rules here.
  "boundaries": {
    "tags": {
      "tier:config": {
        "dependencies": { "deny": ["tier:lib", "tier:service", "tier:app"] },
      },
      "tier:lib": { "dependencies": { "deny": ["tier:service", "tier:app"] } },
      "tier:app": { "dependencies": { "deny": ["tier:service"] } },
      "tier:service": {},
    },
  },

  "tasks": {
    "build": {
      "description": "Compile a member to its runnable/publishable artifact (tsdown for libraries, vite for apps). The Encore app has no build task; `encore build` runs in the release job.",
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**", "build/**"],
    },
    "typecheck": {
      "description": "Type-check without emitting: `tsc --noEmit`. After gen (the member's own) and //#gen:workspace: a member's vitest.config.ts imports ./.stackra/vitest.config.",
      "dependsOn": ["^build", "gen", "//#gen:workspace"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
    },
    "lint": {
      "description": "Static analysis, no fixes: oxlint. Deliberately no ^build dependency — linting a package's own source must not require its dependencies to be built.",
      "inputs": ["$TURBO_DEFAULT$", ".oxlintrc.jsonc"],
      "outputs": [],
    },
    "test": {
      "description": "Run each member's vitest suite. No outputs: coverage is written only by test:coverage. After gen and //#gen:workspace, which write the member's .stackra/vitest.config and setup.",
      "dependsOn": ["^build", "gen", "//#gen:workspace"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
    },
    "test:coverage": {
      "description": "`vitest run --coverage` against the shared gate (vitest.shared.ts: lines/functions 80, branches 70). Defined by packages/** only; apps have no coverage gate. After gen and //#gen:workspace, as test.",
      "dependsOn": ["^build", "gen", "//#gen:workspace"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["coverage/**"],
    },
    // ADR 0182 d1, STA-1570: the integration tier. Never cached: the result depends on a live Docker daemon and the
    // Postgres image it builds, which no input hash sees. Docker and Testcontainers settings pass through without
    // entering a key; STACKRA_FISCAL_SANDBOX opts @stackra/fiscal's certification run in (skipped when unset).
    "test:int": {
      "description": "Run a member's `.int.test.ts` files (and gen's .stackra/tests) on a Testcontainers Postgres: `vitest run --config vitest.int.config.ts`. Needs Docker. Defined only by members that have int tests. After gen and //#gen:workspace, as test.",
      "dependsOn": ["^build", "gen", "//#gen:workspace"],
      "cache": false,
      "passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*", "STACKRA_FISCAL_SANDBOX"],
      "outputs": [],
    },
    // `stackra gen` once at the root (`gen:workspace`) over every member with a stackra.config.ts. One root task, not
    // one per member: its two passes resolve the services' clients against each other's manifests, which a per-member
    // graph cannot (a client cycle between services is allowed). It runs the built CLI, so it waits only for
    // @stackra/cli's build (and through ^build its dependencies'); build never waits for gen, which keeps the graph
    // acyclic for @stackra/cli, @stackra/gen and their dependencies, whose own tests still wait for gen.
    // @stackra/testing keeps an authored vitest config that does not merge the generated one: the generated setup
    // imports @stackra/container/testing, which would close a dependency cycle with it (STA-1299).
    "//#gen:workspace": {
      "description": "Generate every member's .stackra/ (tool configs, wiring, schemas, entries) and manifest with the built `stackra` CLI.",
      "dependsOn": ["@stackra/cli#build"],
      "inputs": [
        "runway.yaml",
        "{apps,services,workers}/*/{src,assets}/**",
        "{apps,services,workers}/*/{stackra.config.ts,package.json,tsconfig.json,*.config.ts,*.extend.ts,stackra.manifest.json}",
        "packages/*/*/{src,assets}/**",
        "packages/*/*/{stackra.config.ts,package.json,tsconfig.json,*.config.ts,*.extend.ts,stackra.manifest.json}",
      ],
      "outputs": [
        "{apps,services,workers}/*/.stackra/**",
        "{apps,services,workers}/*/stackra.manifest.json",
        "packages/*/*/.stackra/**",
        "packages/*/*/stackra.manifest.json",
      ],
    },
    // `stackra gen` in one member (services/*, workers/*: the shapes that carry the script). The root pass above skips a
    // member without a stackra.config.ts, so this is the one that generates those. After the root pass: for a member it
    // also covers, the two would otherwise write the same files at once (the rerun is deterministic and writes nothing new).
    "gen": {
      "description": "Generate this member's .stackra/ and stackra.manifest.json with the built `stackra` CLI (`stackra gen` in the member).",
      "dependsOn": ["@stackra/cli#build", "//#gen:workspace"],
      "inputs": [
        "src/**",
        "assets/**",
        "stackra.config.ts",
        "package.json",
        "tsconfig.json",
        "*.config.ts",
        "*.extend.ts",
        "runway.yaml",
      ],
      "outputs": [".stackra/**", "stackra.manifest.json"],
    },
    "format": {
      "description": "Rewrite files in place with oxfmt. Never cached: its job is to mutate the tree.",
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".oxfmtrc.jsonc"],
      "outputs": [],
    },
    "format:check": {
      "description": "Fail if anything is unformatted, without writing. What CI runs instead of format.",
      "inputs": ["$TURBO_DEFAULT$", ".oxfmtrc.jsonc"],
      "outputs": [],
    },
    "gen:client": {
      "description": "Regenerate the typed API client from the Encore app. Output is committed and compared byte-for-byte in CI.",
      "cache": false,
    },
    "clean": {
      "description": "Remove a member's build output and local caches.",
      "cache": false,
    },
    "dev": {
      "description": "Long-running dev/watch process.",
      "cache": false,
      "persistent": true,
      "interruptible": true,
    },
  },
}
