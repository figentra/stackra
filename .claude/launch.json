{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@figentra/docs", "dev"],
      "port": 3333
    },
    {
      "name": "playground",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@figentra/playground", "dev"],
      "port": 3710
    },
    {
      "name": "mobile",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@figentra/mobile",
        "exec",
        "expo",
        "start",
        "--dev-client",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "worker-static",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@figentra/worker-static", "dev"],
      "port": 8787
    }
  ]
}
