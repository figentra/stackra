{
  "name": "@figentra/worker-env-sync",
  "version": "0.0.1",
  "private": true,
  "description": "Stackra's environment-sync webhook: a Cloudflare Worker that verifies an Infisical webhook and dispatches the owning repository's env-sync workflow.",
  "keywords": [
    "cloudflare",
    "environment-variables",
    "github-actions",
    "infisical",
    "stackra",
    "webhook"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/workers/env-sync#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "UNLICENSED",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "workers/env-sync"
  },
  "type": "module",
  "imports": {
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ],
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "scripts": {
    "dev": "tsdown && wrangler dev",
    "start": "tsdown && wrangler dev",
    "build": "tsdown",
    "gen": "stackra gen",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist .turbo .wrangler"
  },
  "dependencies": {
    "@stackra/console": "workspace:*"
  },
  "devDependencies": {
    "@stackra/cli": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality",
    "wrangler": "catalog:deploy"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "app",
    "runtimes": [
      "worker"
    ],
    "summary": "Change this when working on the Infisical webhook that dispatches a repository's env-sync workflow; it verifies the signature, refuses any value and routes by project."
  }
}
