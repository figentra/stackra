// Stackra file contract:
// Purpose: the Cloudflare Worker that serves Stackra's hosted static files (ADR 0284). Cloudflare serves dist/site
//          directly and applies its generated `_headers` file (CORS, immutable cache); the one script route,
//          `/-/version` (src/worker/main.ts), names the running version for the deploy smoke's proof (STA-2786).
// Owner: release-operations · Secrets: forbidden — CI passes CLOUDFLARE_API_TOKEN from sops ci/deploy in the environment.
// Carve-out (ADR 0284 decision 8): hand-written until `stackra gen` emits Workers config from runway.yaml (ADR 0168).
// Code facts only (ADR 0519 decision 1): the compatibility date, observability, the custom domain, workers_dev and
// preview URLs are runway.yaml's (`targets.cloudflare-workers.members.static`), rendered on deploy.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Named like the existing `npm-registry` Worker on the same account.
  "name": "stackra-static",
  // Figentra Technologies L.L.C. An account id is an identifier, not a credential; the API token grants access.
  "account_id": "d861f9ac9df28b7f0b1298cc0c89bc9d",
  // Bundled by wrangler; tsdown builds only the site builder (src/main.ts).
  "main": "./src/worker/main.ts",
  // The id of the version that runs, read by src/worker/main.ts.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "assets": {
    // Written by `pnpm build` (src/main.ts) from tools/schemas and every schemas@<version> tag.
    "directory": "./dist/site",
    "binding": "ASSETS",
    // Only the version route runs the script first; every other path is the static site.
    "run_worker_first": ["/-/version"],
    // An unknown path returns status 404 with the generated 404.html, the branded "nothing to see here" page.
    "not_found_handling": "404-page",
    // The default, stated: `/` serves index.html, and /index.html redirects to `/`.
    "html_handling": "auto-trailing-slash",
  },
}
