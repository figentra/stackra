// Turborepo package configuration: extends the root turbo.jsonc and declares this member's one tier tag
// (pnpm validate checks it matches the directory). Task overrides for this member only go here.
// Owner: release-operations · Secrets: forbidden
{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["tier:app"],
  "tasks": {
    // The build reads tools/schemas at the working tree and at every `schemas@<version>` git tag (ADR 0284).
    // A new tag changes the output without changing any file turbo hashes, so a cached replay could deploy a
    // site that lacks a release. The build takes milliseconds; never cache it.
    "build": { "cache": false },
  },
}
