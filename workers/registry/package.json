{
  "name": "@figentra/worker-registry",
  "version": "0.0.1",
  "private": true,
  "description": "The Stackra registry: the npm-compatible Cloudflare Worker behind npm.stackra.figentra.com (R2 tarballs, D1 metadata, KV caches, the kinds catalogue).",
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "scripts": {
    "dev": "tsdown && wrangler dev",
    "start": "tsdown && wrangler dev",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist .turbo .wrangler"
  },
  "devDependencies": {
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality",
    "wrangler": "catalog:deploy"
  }
}
