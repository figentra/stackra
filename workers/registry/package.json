{
  "name": "@figentra/worker-registry",
  "version": "0.0.1",
  "private": true,
  "description": "The Stackra registry: the npm-compatible Cloudflare Worker behind npm.stackra.figentra.com (R2 tarballs, D1 metadata, KV caches, the kinds catalogue).",
  "keywords": [
    "cloudflare",
    "d1",
    "kv",
    "licensing",
    "npm-registry",
    "package-registry",
    "r2",
    "stackra"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/workers/registry#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "UNLICENSED",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "workers/registry"
  },
  "type": "module",
  "imports": {
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*/index.ts"
    ],
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "scripts": {
    "dev": "tsdown && wrangler dev",
    "start": "tsdown && wrangler dev",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist .turbo .wrangler"
  },
  "devDependencies": {
    "@stackra/licensing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality",
    "wrangler": "catalog:deploy"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "app",
    "runtimes": [
      "worker"
    ],
    "summary": "Change this when working on how @stackra and @stackra-pro items are published, stored or served over the npm protocol at npm.stackra.figentra.com, including licence-gated reads."
  }
}
