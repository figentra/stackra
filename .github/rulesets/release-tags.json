{
  "name": "release-tags",
  "target": "tag",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/tags/runway-v*",
        "refs/tags/schemas@*",
        "refs/tags/@stackra/*@*",
        "refs/tags/@figentra/*@*"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [{ "type": "deletion" }, { "type": "non_fast_forward" }, { "type": "update" }]
}
