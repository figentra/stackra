# Stackra file contract:
# Purpose: the one formatting contract every editor honours before any formatter runs
# Scope: repository-wide
# Owner: docs-governance
# Secrets: forbidden

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{md,mdx}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.sql]
indent_size = 2
