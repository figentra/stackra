// Turborepo package configuration: extends the root turbo.jsonc and declares this member's tags
// (tier, category, runtimes; pnpm validate checks them). Member-only task overrides go here.
// Owner: release-operations · Secrets: forbidden
{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["tier:app", "runtime:browser"],
  "tasks": {
    // `stackra lint` runs the built CLI (packages/developer/cli/dist), so unlike the root lint this one waits for it;
    // it also builds the docs site into .stackra/site, so it runs after `build` and the two never write it at once.
    "lint": { "dependsOn": ["@stackra/cli#build", "build"] },
  },
}
