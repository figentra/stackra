{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Stackra",
  "description": "Stackra — the @stackra/* packages, apps and services, and how to work in the monorepo.",
  "colors": {
    "primary": "#4F46E5",
    "light": "#818CF8",
    "dark": "#4338CA"
  },
  "favicon": "/assets/favicon.svg",
  "logo": {
    "light": "/assets/logo/light.svg",
    "dark": "/assets/logo/dark.svg",
    "href": "/"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "search": {
    "prompt": "Search the Stackra docs"
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "Stackra"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "This page moved or never existed. Try search."
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart", "development"]
          },
          {
            "group": "Monorepo",
            "pages": [
              "guides/structure",
              "guides/packages",
              "guides/tooling",
              "guides/workflow",
              "guides/definition-of-done",
              "guides/scaffolding"
            ]
          }
        ]
      },
      {
        "tab": "Constitution",
        "icon": "shield",
        "groups": [
          {
            "group": "Laws",
            "pages": [
              "constitution/index",
              "constitution/boundaries",
              "constitution/secrets",
              "constitution/http-and-events"
            ]
          }
        ]
      },
      {
        "tab": "Architecture",
        "icon": "landmark",
        "groups": [
          {
            "group": "Decisions",
            "pages": [
              "adr/index",
              "adr/0001-monorepo-layout",
              "adr/0002-docs-on-mintlify",
              "adr/0003-tier-dependency-direction",
              "adr/0004-package-archetypes-and-layers",
              "adr/0005-di-container-and-legacy-decorators",
              "adr/0006-naming-exports-and-imports",
              "adr/0007-source-documentation-standard",
              "adr/0008-test-placement",
              "adr/0022-tests-live-in-tests-folders",
              "adr/0009-secrets-two-mechanisms",
              "adr/0010-services-are-independent-workspace-members",
              "adr/0011-rejected-and-deferred-technologies",
              "adr/0012-code-host-and-ci"
            ]
          }
        ]
      },
      {
        "tab": "Standards",
        "icon": "check-circle",
        "groups": [
          {
            "group": "Rules",
            "pages": [
              "standards/members",
              "standards/packages",
              "standards/services",
              "standards/apps",
              "standards/code-style",
              "standards/testing",
              "standards/dependencies"
            ]
          }
        ]
      },
      {
        "tab": "Runbooks",
        "icon": "zap",
        "groups": [
          {
            "group": "Operations",
            "pages": [
              "runbooks/secrets",
              "runbooks/ci",
              "runbooks/release",
              "runbooks/mobile-release"
            ]
          }
        ]
      },
      {
        "tab": "Agents",
        "icon": "cpu",
        "groups": [
          {
            "group": "Setup",
            "pages": ["agents/index", "agents/roster", "agents/hooks", "agents/concurrent-sessions"]
          }
        ]
      },
      {
        "tab": "Writing docs",
        "icon": "pen-line",
        "groups": [
          {
            "group": "Authoring",
            "pages": [
              "writing/markdown",
              "writing/code",
              "writing/images",
              "writing/components",
              "writing/navigation",
              "writing/reusable-snippets",
              "writing/settings"
            ]
          }
        ]
      }
    ]
  }
}
