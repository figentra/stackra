{
  "name": "@figentra/docs",
  "version": "0.0.1",
  "private": true,
  "description": "Stackra documentation site — Mintlify (docs.json + MDX).",
  "keywords": [
    "adr",
    "app",
    "documentation",
    "mdx",
    "mintlify",
    "stackra",
    "system-map"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/apps/docs#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "UNLICENSED",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "apps/docs"
  },
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "cd src && mint dev --port 3333",
    "build": "cd src && mint validate",
    "lint": "cd src && mint broken-links",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "a11y": "cd src && mint a11y",
    "clean": "rm -rf src/.mintlify .turbo"
  },
  "dependencies": {
    "@stackra/gen": "workspace:*"
  },
  "devDependencies": {
    "@stackra/testing": "workspace:*",
    "mint": "catalog:docs",
    "oxfmt": "catalog:quality"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "app",
    "runtimes": [
      "browser"
    ],
    "summary": "Edit this when writing or changing Stackra documentation pages, ADRs or the system map; it is the Mintlify site, not a TypeScript member."
  }
}
