{
  "name": "@figentra/docs",
  "version": "0.0.1",
  "private": true,
  "description": "Stackra documentation site: authored pages and DocsConfig; stackra gen assembles the Mintlify site into .stackra/site.",
  "keywords": [
    "adr",
    "documentation",
    "mdx",
    "mintlify",
    "stackra",
    "system-map"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/apps/docs#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "UNLICENSED",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "apps/docs"
  },
  "type": "module",
  "imports": {
    "#scripts/*": "./scripts/*.ts"
  },
  "scripts": {
    "dev": "stackra dev",
    "build": "stackra build",
    "lint": "stackra lint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf .stackra .turbo"
  },
  "dependencies": {
    "@stackra/gen": "workspace:*"
  },
  "devDependencies": {
    "@stackra/cli": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/testing": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "mint": "catalog:docs",
    "oxfmt": "catalog:quality"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "app",
    "runtimes": [
      "browser"
    ],
    "summary": "Edit this when writing or changing Stackra documentation pages, ADRs or the system map; it is the Mintlify site, not a TypeScript member."
  }
}
