{
  "name": "@figentra/docs",
  "version": "0.0.1",
  "private": true,
  "description": "Stackra documentation site: authored pages and DocsConfig; stackra gen assembles the Mintlify site into .stackra/site and, until the cutover, the Fumadocs site into .stackra/fumadocs.",
  "keywords": [
    "adr",
    "documentation",
    "fumadocs",
    "mdx",
    "mintlify",
    "stackra",
    "system-map"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/apps/docs#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "UNLICENSED",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "apps/docs"
  },
  "type": "module",
  "imports": {
    "#scripts/*": "./scripts/*.ts"
  },
  "scripts": {
    "dev": "stackra dev",
    "build": "stackra build",
    "lint": "stackra lint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:e2e": "stackra build --target fumadocs && stackra lint --target fumadocs && stackra test --tier e2e",
    "clean": "rm -rf .stackra .turbo test-results playwright-report"
  },
  "dependencies": {
    "@stackra/gen": "workspace:*",
    "fumadocs-core": "catalog:docs",
    "fumadocs-mdx": "catalog:docs",
    "fumadocs-ui": "catalog:docs",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "react-router": "catalog:frontend"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:e2e",
    "@playwright/test": "catalog:e2e",
    "@react-router/dev": "catalog:frontend",
    "@stackra/cli": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/testing": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@tailwindcss/vite": "catalog:frontend",
    "@types/node": "catalog:",
    "mint": "catalog:docs",
    "oxfmt": "catalog:quality",
    "tailwindcss": "catalog:frontend",
    "vite": "catalog:frontend",
    "vitest": "catalog:quality",
    "wrangler": "catalog:deploy"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "app",
    "runtimes": [
      "browser"
    ],
    "summary": "Edit this when writing or changing Stackra documentation pages, ADRs or the system map; it is the Mintlify site, not a TypeScript member."
  }
}
