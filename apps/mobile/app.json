{
  "expo": {
    "name": "Stackra",
    "slug": "stackra",
    "scheme": "stackra",
    "version": "0.0.1",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/app-icon-ios-1024.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.figentra.stackra",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.figentra.stackra",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-android-foreground-1024.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "react-native-bottom-tabs",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/st-tile-light-256.png",
          "imageWidth": 96,
          "backgroundColor": "#F5F6F3",
          "dark": {
            "image": "./assets/st-tile-dark-256.png",
            "backgroundColor": "#0B0D0F"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": {
            "ios": ["en", "ar"],
            "android": ["en", "ar"]
          }
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Allow Stackra to use your activity in other companies' apps and websites to measure its marketing. Without it, no marketing tracking runs."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Stackra uses the camera to scan barcodes and QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Stackra uses your location only while you use the app, when a feature you open needs it.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Stackra reads only the photos you choose to attach.",
          "savePhotosPermission": "Stackra saves images to your photo library only when you ask it to.",
          "granularPermissions": ["photo"]
        }
      ],
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Stackra uses Face ID to unlock the app when the app lock is on."
        }
      ],
      "@stackra/native-share",
      "@stackra/native-customer-display"
    ]
  }
}
