{
  "name": "@figentra/mobile",
  "version": "0.0.1",
  "private": true,
  "description": "Stackra mobile app — Expo SDK 57, code-based React Navigation (native stack + native tabs, iOS 26 Liquid Glass), HeroUI Native + Uniwind.",
  "keywords": [
    "android",
    "expo",
    "heroui-native",
    "ios",
    "liquid-glass",
    "react-navigation",
    "stackra"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/apps/mobile#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "UNLICENSED",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "apps/mobile"
  },
  "main": "src/main.ts",
  "imports": {
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ],
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "scripts": {
    "brand:pull": "node ../../tools/scripts/brand-pull.mjs",
    "predev": "pnpm brand:pull",
    "dev": "expo start",
    "preios": "pnpm brand:pull",
    "ios": "expo run:ios",
    "preandroid": "pnpm brand:pull",
    "android": "expo run:android",
    "build": "expo export --platform ios --platform android --output-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "doctor": "expo install --check",
    "clean": "rm -rf dist .expo ios android .turbo"
  },
  "dependencies": {
    "@bottom-tabs/react-navigation": "catalog:mobile",
    "@expo/ui": "catalog:mobile",
    "@gorhom/bottom-sheet": "catalog:mobile",
    "@internationalized/date": "catalog:mobile",
    "@internationalized/number": "catalog:mobile",
    "@react-native-community/netinfo": "catalog:mobile",
    "@react-navigation/native": "catalog:mobile",
    "@react-navigation/native-stack": "catalog:mobile",
    "@shopify/react-native-skia": "catalog:mobile",
    "@stackra/consent": "workspace:*",
    "@stackra/container": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/filesystem": "workspace:*",
    "@stackra/i18n": "workspace:*",
    "@stackra/icons": "workspace:*",
    "@stackra/media": "workspace:*",
    "@stackra/native-customer-display": "workspace:*",
    "@stackra/native-share": "workspace:*",
    "@stackra/platform": "workspace:*",
    "@stackra/settings": "workspace:*",
    "@stackra/showcase": "workspace:*",
    "@stackra/theming": "workspace:*",
    "@stackra/tokens": "workspace:*",
    "@stackra/ui": "workspace:*",
    "expo": "catalog:mobile",
    "expo-alternate-app-icons": "catalog:mobile",
    "expo-background-task": "catalog:mobile",
    "expo-battery": "catalog:mobile",
    "expo-build-properties": "catalog:mobile",
    "expo-camera": "catalog:mobile",
    "expo-clipboard": "catalog:mobile",
    "expo-constants": "catalog:mobile",
    "expo-dev-client": "catalog:mobile",
    "expo-document-picker": "catalog:mobile",
    "expo-file-system": "catalog:mobile",
    "expo-font": "catalog:mobile",
    "expo-glass-effect": "catalog:mobile",
    "expo-haptics": "catalog:mobile",
    "expo-image-picker": "catalog:mobile",
    "expo-intent-launcher": "catalog:mobile",
    "expo-linking": "catalog:mobile",
    "expo-local-authentication": "catalog:mobile",
    "expo-localization": "catalog:mobile",
    "expo-location": "catalog:mobile",
    "expo-media-library": "catalog:mobile",
    "expo-notifications": "catalog:mobile",
    "expo-secure-store": "catalog:mobile",
    "expo-sharing": "catalog:mobile",
    "expo-splash-screen": "catalog:mobile",
    "expo-status-bar": "catalog:mobile",
    "expo-system-ui": "catalog:mobile",
    "expo-tracking-transparency": "catalog:mobile",
    "expo-updates": "catalog:mobile",
    "expo-widgets": "catalog:mobile",
    "heroui-native": "catalog:mobile",
    "lucide-react-native": "catalog:mobile",
    "react": "catalog:mobile",
    "react-dom": "catalog:mobile",
    "react-hook-form": "catalog:frontend",
    "react-native": "catalog:mobile",
    "react-native-bottom-tabs": "catalog:mobile",
    "react-native-gesture-handler": "catalog:mobile",
    "react-native-mmkv": "catalog:mobile",
    "react-native-nitro-modules": "catalog:mobile",
    "react-native-reanimated": "catalog:mobile",
    "react-native-safe-area-context": "catalog:mobile",
    "react-native-screens": "catalog:mobile",
    "react-native-svg": "catalog:mobile",
    "react-native-worklets": "catalog:mobile",
    "tailwind-merge": "catalog:mobile",
    "tailwind-variants": "catalog:mobile",
    "tailwindcss": "catalog:frontend",
    "uniwind": "catalog:uniwind-pro",
    "victory-native": "catalog:mobile"
  },
  "devDependencies": {
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/react": "catalog:mobile",
    "babel-preset-expo": "catalog:mobile",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "typescript": "catalog:mobile",
    "vitest": "catalog:quality"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "app",
    "runtimes": [
      "react-native"
    ],
    "summary": "Work here on the Stackra iOS and Android app shell: its Expo configuration, code-based React Navigation and HeroUI Native screens."
  }
}
