{
  "name": "@figentra/playground",
  "version": "0.0.1",
  "private": true,
  "description": "The Stackra Design System playground: every @stackra/ui component on its own route, in light and dark and in left-to-right and right-to-left, checked by Playwright and axe.",
  "keywords": [
    "axe",
    "component-review",
    "design-system",
    "heroui",
    "playground",
    "playwright",
    "rtl",
    "stackra"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/apps/playground#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "UNLICENSED",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "apps/playground"
  },
  "type": "module",
  "imports": {
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ],
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "scripts": {
    "dev": "vite --port 3710 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 3710 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "clean": "rm -rf dist coverage .turbo test-results playwright-report"
  },
  "dependencies": {
    "@heroui-pro/react": "catalog:frontend",
    "@heroui/react": "catalog:frontend",
    "@heroui/styles": "catalog:frontend",
    "@internationalized/date": "catalog:frontend",
    "@number-flow/react": "catalog:frontend",
    "@stackra-pro/ui": "workspace:*",
    "@stackra/container": "workspace:*",
    "@stackra/icons": "workspace:*",
    "@stackra/navigation": "workspace:*",
    "@stackra/tokens": "workspace:*",
    "@stackra/ui": "workspace:*",
    "@tiptap/core": "catalog:frontend",
    "@tiptap/extension-link": "catalog:frontend",
    "@tiptap/extension-underline": "catalog:frontend",
    "@tiptap/extensions": "catalog:frontend",
    "@tiptap/pm": "catalog:frontend",
    "@tiptap/react": "catalog:frontend",
    "@tiptap/starter-kit": "catalog:frontend",
    "@tiptap/suggestion": "catalog:frontend",
    "embla-carousel": "catalog:frontend",
    "embla-carousel-react": "catalog:frontend",
    "maplibre-gl": "catalog:frontend",
    "marked": "catalog:frontend",
    "motion": "catalog:frontend",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "react-hook-form": "catalog:frontend",
    "react-markdown": "catalog:frontend",
    "react-resizable-panels": "catalog:frontend",
    "react-router": "catalog:frontend",
    "recharts": "catalog:frontend",
    "remark-breaks": "catalog:frontend",
    "remark-gfm": "catalog:frontend",
    "shiki": "catalog:frontend",
    "streamdown": "catalog:frontend"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:e2e",
    "@playwright/test": "catalog:e2e",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@tailwindcss/vite": "catalog:frontend",
    "@testing-library/dom": "catalog:frontend",
    "@testing-library/react": "catalog:frontend",
    "@types/node": "catalog:",
    "@types/react": "catalog:frontend",
    "@types/react-dom": "catalog:frontend",
    "@vitejs/plugin-react": "catalog:frontend",
    "jsdom": "catalog:frontend",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tailwindcss": "catalog:frontend",
    "typescript": "catalog:build",
    "vite": "catalog:frontend",
    "vitest": "catalog:quality"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "app",
    "runtimes": [
      "browser"
    ],
    "summary": "Use it to view or review every @stackra/ui component in light, dark, left-to-right and right-to-left, and add a route here for each new component; it is a dev tool and is never deployed."
  }
}
