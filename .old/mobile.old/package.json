{
  "name": "@stackra/mobile",
  "version": "0.0.1",
  "private": true,
  "description": "Stackra mobile app — Expo SDK 57 + expo-router native tabs (iOS 26 Liquid Glass) + HeroUI Native + Uniwind.",
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "doctor": "expo install --check",
    "clean": "rm -rf .expo ios android .turbo"
  },
  "dependencies": {
    "@expo/metro-runtime": "catalog:mobile",
    "@gorhom/bottom-sheet": "catalog:mobile",
    "expo": "catalog:mobile",
    "expo-blur": "catalog:mobile",
    "expo-constants": "catalog:mobile",
    "expo-dev-client": "catalog:mobile",
    "expo-glass-effect": "catalog:mobile",
    "expo-linking": "catalog:mobile",
    "expo-router": "catalog:mobile",
    "expo-splash-screen": "catalog:mobile",
    "expo-status-bar": "catalog:mobile",
    "expo-system-ui": "catalog:mobile",
    "heroui-native": "catalog:mobile",
    "react": "catalog:mobile",
    "react-dom": "catalog:mobile",
    "react-native": "catalog:mobile",
    "react-native-gesture-handler": "catalog:mobile",
    "react-native-reanimated": "catalog:mobile",
    "react-native-safe-area-context": "catalog:mobile",
    "react-native-screens": "catalog:mobile",
    "react-native-svg": "catalog:mobile",
    "react-native-web": "catalog:mobile",
    "react-native-worklets": "catalog:mobile",
    "tailwind-merge": "catalog:mobile",
    "tailwind-variants": "catalog:mobile",
    "tailwindcss": "catalog:frontend",
    "uniwind": "catalog:mobile"
  },
  "devDependencies": {
    "@stackra/typescript-config": "workspace:*",
    "@types/react": "catalog:mobile",
    "babel-preset-expo": "catalog:mobile",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "typescript": "catalog:mobile"
  }
}
