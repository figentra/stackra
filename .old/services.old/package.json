{
  "name": "@stackra/backend",
  "version": "0.0.1",
  "private": true,
  "description": "The Stackra Encore.ts application: one app, every service under src/<service>.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "encore run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "node scripts/test.mjs",
    "gen:client": "encore gen client --lang=typescript --output=./encore.gen/client.ts",
    "clean": "rm -rf encore.gen .encore .turbo"
  },
  "dependencies": {
    "encore.dev": "^1.58.6"
  },
  "devDependencies": {
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  }
}
