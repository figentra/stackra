{
  "name": "@stackra/brand",
  "version": "0.0.0",
  "private": true,
  "description": "Stackra brand: tokens, HeroUI web and native themes, fonts, logos, marks, icons and app icons",
  "license": "MIT",
  "files": [
    "src",
    "dist",
    "resources",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@stackra/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./tokens": {
      "@stackra/source": "./src/tokens/tokens.ts",
      "types": "./dist/tokens.d.mts",
      "default": "./dist/tokens.mjs"
    },
    "./tokens.css": "./resources/heroui/web.css",
    "./tokens.json": "./src/tokens/tokens.json",
    "./logos": "./resources/logos",
    "./fonts": "./resources/fonts",
    "./resources/*": "./resources/*"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "devDependencies": {
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  }
}
