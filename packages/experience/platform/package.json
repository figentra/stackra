{
  "name": "@stackra/platform",
  "version": "0.0.0",
  "private": false,
  "description": "Stackra platform: the Platform capability port with its typed refusal, the push, captcha, kiosk-mode and second-screen ports, the desktop, PWA and push configurations, memory, web, Electron (platform, kiosk mode, second screen), Expo (platform and push) and Turnstile (Worker and Node) drivers, the Bridge kind and its kiosk and second-screen bridges, the service-worker handlers, the React hooks and fakePlatform",
  "keywords": [
    "electron",
    "experience",
    "expo",
    "kiosk",
    "platform-capabilities",
    "push-notifications",
    "pwa",
    "stackra"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/experience/platform#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/experience/platform"
  },
  "files": [
    "dist",
    "src",
    "assets",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#browser/*": [
      "./src/browser/*",
      "./src/browser/*.ts",
      "./src/browser/*.tsx",
      "./src/browser/*/index.ts"
    ],
    "#config/*": [
      "./src/config/*",
      "./src/config/*.ts"
    ],
    "#contracts/*": [
      "./src/contracts/*",
      "./src/contracts/*.ts",
      "./src/contracts/*/index.ts"
    ],
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ],
    "#desktop/*": [
      "./src/desktop/*",
      "./src/desktop/*.ts",
      "./src/desktop/*/index.ts"
    ],
    "#native/*": [
      "./src/native/*",
      "./src/native/*.ts",
      "./src/native/*.tsx",
      "./src/native/*/index.ts"
    ],
    "#node/*": [
      "./src/node/*",
      "./src/node/*.ts",
      "./src/node/*/index.ts"
    ],
    "#react/*": [
      "./src/react/*",
      "./src/react/*.ts",
      "./src/react/*.tsx",
      "./src/react/*/index.ts"
    ],
    "#sw/*": [
      "./src/sw/*",
      "./src/sw/*.ts",
      "./src/sw/*/index.ts"
    ],
    "#testing/*": [
      "./src/testing/*",
      "./src/testing/*.ts",
      "./src/testing/*/index.ts"
    ],
    "#worker/*": [
      "./src/worker/*",
      "./src/worker/*.ts",
      "./src/worker/*/index.ts"
    ],
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./contracts": {
      "@stackra/source": "./src/contracts/index.ts",
      "types": "./dist/contracts.d.mts",
      "default": "./dist/contracts.mjs"
    },
    "./browser": {
      "@stackra/source": "./src/browser/index.ts",
      "types": "./dist/browser.d.mts",
      "default": "./dist/browser.mjs"
    },
    "./desktop": {
      "@stackra/source": "./src/desktop/index.ts",
      "types": "./dist/desktop.d.mts",
      "default": "./dist/desktop.mjs"
    },
    "./native": {
      "@stackra/source": "./src/native/index.ts",
      "types": "./dist/native.d.mts",
      "default": "./dist/native.mjs"
    },
    "./node": {
      "@stackra/source": "./src/node/index.ts",
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./react": {
      "@stackra/source": "./src/react/index.ts",
      "types": "./dist/react.d.mts",
      "default": "./dist/react.mjs"
    },
    "./sw": {
      "@stackra/source": "./src/sw/index.ts",
      "types": "./dist/sw.d.mts",
      "default": "./dist/sw.mjs"
    },
    "./testing": {
      "@stackra/source": "./src/testing/index.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    },
    "./worker": {
      "@stackra/source": "./src/worker/index.ts",
      "types": "./dist/worker.d.mts",
      "default": "./dist/worker.mjs"
    },
    "./assets/*": "./assets/*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@stackra/config": "workspace:*",
    "@stackra/container": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/filesystem": "workspace:*",
    "@stackra/state": "workspace:*",
    "@stackra/storage": "workspace:*",
    "@stackra/validation": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@react-native-community/netinfo": "catalog:mobile",
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@testing-library/dom": "catalog:frontend",
    "@testing-library/react": "catalog:frontend",
    "@types/node": "catalog:",
    "@types/react": "catalog:frontend",
    "@types/react-dom": "catalog:frontend",
    "@vitest/coverage-v8": "catalog:quality",
    "electron": "catalog:desktop",
    "expo-background-task": "catalog:mobile",
    "expo-battery": "catalog:mobile",
    "expo-camera": "catalog:mobile",
    "expo-constants": "catalog:mobile",
    "expo-haptics": "catalog:mobile",
    "expo-location": "catalog:mobile",
    "expo-media-library": "catalog:mobile",
    "expo-notifications": "catalog:mobile",
    "expo-tracking-transparency": "catalog:mobile",
    "fake-indexeddb": "catalog:quality",
    "jsdom": "catalog:frontend",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "react-native": "catalog:mobile",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "peerDependencies": {
    "@react-native-community/netinfo": "catalog:mobile",
    "electron": "catalog:desktop",
    "expo-background-task": "catalog:mobile",
    "expo-battery": "catalog:mobile",
    "expo-camera": "catalog:mobile",
    "expo-constants": "catalog:mobile",
    "expo-haptics": "catalog:mobile",
    "expo-location": "catalog:mobile",
    "expo-media-library": "catalog:mobile",
    "expo-notifications": "catalog:mobile",
    "expo-tracking-transparency": "catalog:mobile",
    "react": "catalog:frontend",
    "react-native": "catalog:mobile"
  },
  "peerDependenciesMeta": {
    "@react-native-community/netinfo": {
      "optional": true
    },
    "electron": {
      "optional": true
    },
    "expo-background-task": {
      "optional": true
    },
    "expo-battery": {
      "optional": true
    },
    "expo-camera": {
      "optional": true
    },
    "expo-constants": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    },
    "expo-location": {
      "optional": true
    },
    "expo-media-library": {
      "optional": true
    },
    "expo-notifications": {
      "optional": true
    },
    "expo-tracking-transparency": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "experience",
    "runtimes": [
      "isomorphic",
      "node",
      "browser",
      "worker",
      "react-native"
    ],
    "summary": "Use it to ask what the running target supports and use it (push, captcha, kiosk mode, second screen, service worker, sharing, haptics) across web, PWA, Electron and Expo without platform checks in app code."
  }
}
