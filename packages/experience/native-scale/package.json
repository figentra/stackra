{
  "name": "@stackra/native-scale",
  "version": "0.0.0",
  "private": false,
  "description": "Stackra native scale: the Expo module behind the Scale port of @stackra/peripherals, with one driver per scale protocol (Mettler Toledo MT-SICS and the continuous ASCII stream of A&D-style indicators) over Bluetooth LE, Bluetooth serial (SPP) and USB serial, and its config plugin",
  "keywords": [
    "experience",
    "expo-module",
    "mt-sics",
    "point-of-sale",
    "scale",
    "stackra"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/experience/native-scale#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/experience/native-scale"
  },
  "files": [
    "dist",
    "src",
    "ios",
    "android/build.gradle",
    "android/src",
    "plugin/src",
    "app.plugin.js",
    "expo-module.config.json",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#config/*": [
      "./src/config/*",
      "./src/config/*.ts"
    ],
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p plugin",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@stackra/config": "workspace:*",
    "@stackra/container": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/peripherals": "workspace:*",
    "@stackra/platform": "workspace:*",
    "@stackra/validation": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:frontend",
    "@vitest/coverage-v8": "catalog:quality",
    "expo": "catalog:mobile",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "peerDependencies": {
    "expo": "catalog:mobile"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "experience",
    "runtimes": [
      "isomorphic"
    ],
    "summary": "Use it when an Expo app reads a retail or precision scale over Bluetooth or USB serial behind the Scale port."
  }
}
