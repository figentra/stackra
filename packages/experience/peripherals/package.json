{
  "name": "@stackra/peripherals",
  "version": "0.0.0",
  "private": false,
  "description": "Stackra peripherals: the ReceiptPrinter, LabelPrinter, CashDrawer, BarcodeScanner, Scale, CustomerDisplay and CardTerminal ports with their typed refusals, PeripheralsConfig, memory drivers, the channel customer display, in-store and GS1 weight and price barcode parsing, the ScannerScale, BaggingScale, LabelScale and DriveThroughLane ports with memory drivers, ESC/POS receipts with the drawer kick through the printer, ZPL labels, the Electron main-process drivers and print bridges, and the Sunmi, PAX and iMin printer, drawer and scanner drivers of the native Android till",
  "keywords": [
    "barcode-scanner",
    "cash-drawer",
    "escpos",
    "experience",
    "point-of-sale",
    "receipt-printer",
    "scale",
    "stackra"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/experience/peripherals#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/experience/peripherals"
  },
  "files": [
    "dist",
    "src",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#config/*": [
      "./src/config/*",
      "./src/config/*.ts"
    ],
    "#contracts/*": [
      "./src/contracts/*",
      "./src/contracts/*.ts",
      "./src/contracts/*/index.ts"
    ],
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ],
    "#desktop/*": [
      "./src/desktop/*",
      "./src/desktop/*.ts",
      "./src/desktop/*/index.ts"
    ],
    "#native/*": [
      "./src/native/*",
      "./src/native/*.ts",
      "./src/native/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./contracts": {
      "@stackra/source": "./src/contracts/index.ts",
      "types": "./dist/contracts.d.mts",
      "default": "./dist/contracts.mjs"
    },
    "./desktop": {
      "@stackra/source": "./src/desktop/index.ts",
      "types": "./dist/desktop.d.mts",
      "default": "./dist/desktop.mjs"
    },
    "./native": {
      "@stackra/source": "./src/native/index.ts",
      "types": "./dist/native.d.mts",
      "default": "./dist/native.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@stackra/config": "workspace:*",
    "@stackra/container": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/errors": "workspace:*",
    "@stackra/platform": "workspace:*",
    "@stackra/validation": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:frontend",
    "@vitest/coverage-v8": "catalog:quality",
    "electron": "catalog:desktop",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "peerDependencies": {
    "electron": "catalog:desktop"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "experience",
    "runtimes": [
      "isomorphic",
      "node"
    ],
    "summary": "Use it when a client drives point-of-sale hardware such as receipt and label printers, cash drawers, scanners, scales, customer displays or card terminals."
  }
}
