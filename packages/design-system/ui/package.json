{
  "name": "@stackra/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Stackra Design System components: one component API, contracts shared, HeroUI v3 on web, HeroUI Native and Uniwind on native.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/design-system/ui"
  },
  "files": [
    "dist",
    "src",
    "assets",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#contracts/*": [
      "./src/contracts/*",
      "./src/contracts/*.ts",
      "./src/contracts/*.tsx",
      "./src/contracts/*/index.ts"
    ],
    "#config/*": [
      "./src/config/*",
      "./src/config/*.ts",
      "./src/config/*.tsx",
      "./src/config/*/index.ts"
    ],
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*.tsx",
      "./src/core/*/index.ts"
    ],
    "#node/*": [
      "./src/node/*",
      "./src/node/*.ts",
      "./src/node/*.tsx",
      "./src/node/*/index.ts"
    ],
    "#react/*": [
      "./src/react/*",
      "./src/react/*.ts",
      "./src/react/*.tsx",
      "./src/react/*/index.ts"
    ],
    "#native/*": [
      "./src/native/*",
      "./src/native/*.ts",
      "./src/native/*.tsx",
      "./src/native/*/index.ts"
    ],
    "#testing/*": [
      "./src/testing/*",
      "./src/testing/*.ts",
      "./src/testing/*.tsx",
      "./src/testing/*/index.ts"
    ],
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/config/ui.config.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "@stackra/source": "./src/node/ui.module.ts",
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./assets/*": "./assets/*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "devDependencies": {
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  }
}
