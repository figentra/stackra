{
  "name": "@stackra/ui",
  "version": "0.2.0",
  "private": false,
  "description": "Stackra Design System components: one component API, contracts shared, HeroUI v3 on web, HeroUI Native and Uniwind on native.",
  "keywords": [
    "components",
    "design-system",
    "heroui",
    "heroui-native",
    "react",
    "stackra",
    "ui-kit"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/design-system/ui#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/design-system/ui"
  },
  "files": [
    "dist",
    "src",
    "assets",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#contracts/*": [
      "./src/contracts/*",
      "./src/contracts/*.ts",
      "./src/contracts/*.tsx",
      "./src/contracts/*/index.ts"
    ],
    "#config/*": [
      "./src/config/*",
      "./src/config/*.ts",
      "./src/config/*.tsx",
      "./src/config/*/index.ts"
    ],
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*.tsx",
      "./src/core/*/index.ts"
    ],
    "#form/*": [
      "./src/form/*",
      "./src/form/*.ts",
      "./src/form/*.tsx",
      "./src/form/*/index.ts"
    ],
    "#node/*": [
      "./src/node/*",
      "./src/node/*.ts",
      "./src/node/*.tsx",
      "./src/node/*/index.ts"
    ],
    "#react/*": [
      "./src/react/*",
      "./src/react/*.ts",
      "./src/react/*.tsx",
      "./src/react/*/index.ts"
    ],
    "#native/*": [
      "./src/native/*",
      "./src/native/*.ts",
      "./src/native/*.tsx",
      "./src/native/*/index.ts"
    ],
    "#testing/*": [
      "./src/testing/*",
      "./src/testing/*.ts",
      "./src/testing/*.tsx",
      "./src/testing/*/index.ts"
    ],
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./contracts": {
      "@stackra/source": "./src/contracts/index.ts",
      "types": "./dist/contracts.d.mts",
      "default": "./dist/contracts.mjs"
    },
    "./form": {
      "@stackra/source": "./src/form/index.ts",
      "types": "./dist/form.d.mts",
      "default": "./dist/form.mjs"
    },
    "./node": {
      "@stackra/source": "./src/node/ui.module.ts",
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./react": {
      "@stackra/source": "./src/react/index.ts",
      "types": "./dist/react.d.mts",
      "default": "./dist/react.mjs"
    },
    "./native": {
      "@stackra/source": "./src/native/index.ts",
      "types": "./dist/native.d.mts",
      "default": "./dist/native.mjs"
    },
    "./testing": {
      "@stackra/source": "./src/testing/fakes/fake-confirmation-provider.tsx",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    },
    "./assets/*": "./assets/*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@stackra/config": "workspace:*",
    "@stackra/container": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/i18n": "workspace:*",
    "@stackra/icons": "workspace:*",
    "@stackra/tokens": "workspace:*",
    "@stackra/validation": "workspace:*",
    "uqr": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@expo/ui": "catalog:mobile",
    "@heroui/react": "catalog:frontend",
    "@internationalized/date": "catalog:frontend",
    "@internationalized/number": "catalog:mobile",
    "@shopify/react-native-skia": "catalog:mobile",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@testing-library/dom": "catalog:frontend",
    "@testing-library/react": "catalog:frontend",
    "@types/node": "catalog:",
    "@types/react": "catalog:frontend",
    "@types/react-dom": "catalog:frontend",
    "@vitest/coverage-v8": "catalog:quality",
    "expo-blur": "catalog:mobile",
    "expo-clipboard": "catalog:mobile",
    "expo-document-picker": "catalog:mobile",
    "expo-glass-effect": "catalog:mobile",
    "expo-haptics": "catalog:mobile",
    "expo-image-picker": "catalog:mobile",
    "expo-video": "catalog:mobile",
    "heroui-native": "catalog:mobile",
    "jsdom": "catalog:frontend",
    "lucide-react": "catalog:frontend",
    "lucide-react-native": "catalog:mobile",
    "motion": "catalog:frontend",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "react": "catalog:frontend",
    "react-aria": "catalog:frontend",
    "react-aria-components": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "react-hook-form": "catalog:frontend",
    "react-native": "catalog:mobile",
    "react-native-reanimated": "catalog:mobile",
    "react-native-safe-area-context": "catalog:mobile",
    "react-native-svg": "catalog:mobile",
    "recharts": "catalog:frontend",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "uniwind": "catalog:mobile",
    "victory-native": "catalog:mobile",
    "vitest": "catalog:quality"
  },
  "peerDependencies": {
    "@expo/ui": "^57.0.25",
    "@heroui/react": "^3.2.6",
    "@internationalized/date": "^3.12.4",
    "@internationalized/number": "^3.6.9",
    "@shopify/react-native-skia": "^2.6.2",
    "expo-blur": "^57.0.3",
    "expo-clipboard": ">=57.0.0",
    "expo-document-picker": ">=57.0.0",
    "expo-glass-effect": "^57.0.4",
    "expo-haptics": "^57.0.3",
    "expo-image-picker": ">=57.0.0",
    "expo-video": ">=57.0.0",
    "heroui-native": "^1.0.10",
    "lucide-react": "^1.54.0",
    "lucide-react-native": "^1.54.0",
    "motion": "^12.43.0",
    "react": ">=19.2.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-hook-form": "^7.89.0",
    "react-native": ">=0.86.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-svg": "^15.15.4",
    "recharts": "^3.10.1",
    "uniwind": "^1.12.1",
    "victory-native": "^41.26.0"
  },
  "peerDependenciesMeta": {
    "@expo/ui": {
      "optional": true
    },
    "@heroui/react": {
      "optional": true
    },
    "@internationalized/number": {
      "optional": true
    },
    "@shopify/react-native-skia": {
      "optional": true
    },
    "expo-blur": {
      "optional": true
    },
    "expo-clipboard": {
      "optional": true
    },
    "expo-document-picker": {
      "optional": true
    },
    "expo-glass-effect": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    },
    "expo-image-picker": {
      "optional": true
    },
    "expo-video": {
      "optional": true
    },
    "heroui-native": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "lucide-react-native": {
      "optional": true
    },
    "motion": {
      "optional": true
    },
    "react-aria": {
      "optional": true
    },
    "react-aria-components": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "uniwind": {
      "optional": true
    },
    "victory-native": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "design-system",
    "runtimes": [
      "isomorphic",
      "node",
      "browser",
      "react-native"
    ],
    "summary": "Use it for every UI component in a Stackra app: one component API with shared contracts, rendered by HeroUI on web and HeroUI Native with Uniwind on native."
  }
}
