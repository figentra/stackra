{
  "name": "@stackra/showcase",
  "version": "0.0.0",
  "private": true,
  "description": "The one component registry of the Stackra showcases: categories, entries, docs links, lang catalogues, generated API docs and the search index",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/design-system/showcase"
  },
  "files": [
    "dist",
    "src",
    "api",
    "search",
    "vendor",
    "assets",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*/index.ts"
    ],
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./api/*": "./api/*",
    "./search": "./search/index.json",
    "./assets/*": "./assets/*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo",
    "gen": "node scripts/gen.ts",
    "gen:check": "node scripts/gen.ts --check",
    "hero:import": "node scripts/gen-hero.ts"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "typescript6": "catalog:tooling",
    "vitest": "catalog:quality"
  }
}
