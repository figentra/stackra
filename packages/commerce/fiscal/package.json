{
  "name": "@stackra/fiscal",
  "version": "0.1.0",
  "private": false,
  "description": "Stackra fiscal: e-invoicing and till fiscal drivers chosen by market-pack data behind one FiscalDriver port (ZATCA Phase 2 with a CSID per till, Egypt ETA with item codes and a cloud seal, Peppol for the EU and the UAE through an ASP, Factur-X and ZUGFeRD hybrid PDFs, and the German TSE, French NF525, Belgian FDM, Italian RT, Austrian RKSV and Spanish Verifactu till drivers), the FiscalService that seals offline on a hash chain, submits later and exports the journal, till onboarding per mandate (ZATCA CSIDs, ETA POS client credentials, fiscal-device registration) picked by driver key, receipt QR codes, a production pack source over @stackra/market-packs, the pack, journal, signer, transport, device, credential, cipher and PDF ports, a memory journal, and fakes and a document fixture for tests",
  "keywords": [
    "commerce",
    "e-invoicing",
    "factur-x",
    "fiscal",
    "fiscalization",
    "peppol",
    "stackra",
    "tax-compliance",
    "tse",
    "zatca"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/commerce/fiscal#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/commerce/fiscal"
  },
  "files": [
    "dist",
    "src",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#contracts/*": [
      "./src/contracts/*",
      "./src/contracts/*.ts",
      "./src/contracts/*/index.ts"
    ],
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ],
    "#testing/*": [
      "./src/testing/*",
      "./src/testing/*.ts",
      "./src/testing/*/index.ts"
    ],
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./contracts": {
      "@stackra/source": "./src/contracts/index.ts",
      "types": "./dist/contracts.d.mts",
      "default": "./dist/contracts.mjs"
    },
    "./testing": {
      "@stackra/source": "./src/testing/index.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:int": "vitest run --config vitest.int.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@stackra/container": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/errors": "workspace:*",
    "@stackra/market-packs": "workspace:*",
    "@stackra/money": "workspace:*",
    "@stackra/validation": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "peerDependencies": {
    "@stackra/testing": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@stackra/testing": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "commerce",
    "runtimes": [
      "isomorphic",
      "node"
    ],
    "summary": "Use when a sale or invoice must be sealed, submitted or journaled for a market's tax authority (e-invoicing or till fiscalisation); market-pack data picks the FiscalDriver, so callers never name a country."
  }
}
