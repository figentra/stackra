{
  "name": "@stackra/infra-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Pulumi program for the self-hosted tools stack each region runs (owner decision R3-5): Documenso, the OCR server, Nominatim and Photon on a regional OpenStreetMap extract, LibreTranslate and Chatwoot, planned from the root runway's providers.tools block, with the endpoints OS integrations turns into managed Connections",
  "keywords": [
    "chatwoot",
    "documenso",
    "infrastructure",
    "libretranslate",
    "nominatim",
    "ocr",
    "photon",
    "pulumi",
    "self-hosted",
    "stackra"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/infrastructure/infra-tools#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/infrastructure/infra-tools"
  },
  "files": [
    "dist",
    "src",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ],
    "#node/*": [
      "./src/node/*",
      "./src/node/*.ts",
      "./src/node/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "@stackra/source": "./src/node/index.ts",
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@pulumi/aws": "catalog:infra",
    "@stackra/contracts": "workspace:*",
    "@stackra/runway": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pulumi/pulumi": "catalog:infra",
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "peerDependencies": {
    "@pulumi/pulumi": "catalog:infra"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "infrastructure",
    "runtimes": [
      "isomorphic",
      "node"
    ],
    "summary": "Reach for it when adding, pinning or resizing a self-hosted regional tool (e-signature, OCR, geocoding, translation, support chat) or changing the endpoints integrations connect to."
  }
}
