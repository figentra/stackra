{
  "name": "@stackra/infra-cloudflare",
  "version": "0.0.0",
  "private": false,
  "description": "Pulumi programs for the Cloudflare core stack: the zones and DNS, Worker custom domains, R2 buckets (the Turborepo cache), the dev tunnels, Access, and the edge (TLS, managed WAF, bots, the per-IP rate limit and the API cache bypass) read from the root runway",
  "keywords": [
    "access",
    "cloudflare",
    "dns",
    "infrastructure",
    "infrastructure-as-code",
    "pulumi",
    "r2",
    "stackra",
    "tunnels",
    "waf"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/infrastructure/infra-cloudflare#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/infrastructure/infra-cloudflare"
  },
  "files": [
    "dist",
    "src",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ],
    "#node/*": [
      "./src/node/*",
      "./src/node/*.ts",
      "./src/node/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "@stackra/source": "./src/node/index.ts",
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@pulumi/cloudflare": "catalog:infra",
    "@stackra/container": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/runway": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pulumi/pulumi": "catalog:infra",
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "peerDependencies": {
    "@pulumi/pulumi": "catalog:infra"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "infrastructure",
    "runtimes": [
      "isomorphic",
      "node"
    ],
    "summary": "Reach for it when changing Cloudflare zones, DNS, Worker custom domains, R2 buckets, dev tunnels, Access policies or edge security rules; every value comes from the root runway."
  }
}
