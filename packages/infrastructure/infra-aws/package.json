{
  "name": "@stackra/infra-aws",
  "version": "0.0.0",
  "private": false,
  "description": "Pulumi programs for the free AWS foundation read from the root runway: per environment the data key, the files bucket (media CORS, versioning, replication to the backup account), Postgres point-in-time recovery and snapshot copies, the GitHub OIDC deploy role, the Encore Cloud access role and the budgets that stop non-production accounts; plus the Pulumi state backend and the backup account",
  "keywords": [
    "aws",
    "backups",
    "budgets",
    "infrastructure",
    "infrastructure-as-code",
    "kms",
    "oidc",
    "pulumi",
    "s3",
    "stackra"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/infrastructure/infra-aws#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/infrastructure/infra-aws"
  },
  "files": [
    "dist",
    "src",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ],
    "#node/*": [
      "./src/node/*",
      "./src/node/*.ts",
      "./src/node/*/index.ts"
    ],
    "#testing/*": [
      "./src/testing/*",
      "./src/testing/*.ts",
      "./src/testing/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "@stackra/source": "./src/node/index.ts",
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./testing": {
      "@stackra/source": "./src/testing/index.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@pulumi/aws": "catalog:infra",
    "@stackra/container": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/runway": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pulumi/pulumi": "catalog:infra",
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "peerDependencies": {
    "@pulumi/pulumi": "catalog:infra"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "infrastructure",
    "runtimes": [
      "isomorphic",
      "node"
    ],
    "summary": "Reach for it when changing the per-environment AWS foundation (data key, files bucket, Postgres backups, deploy roles, budgets) or the Pulumi state backend and backup account; its values come from the root runway."
  }
}
