{
  "name": "@stackra/infra-github",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub as code: the repository plan read from the root runway (settings, deployment environments with their reviewers and deploy refs, Actions variables, the CI secret names) and the committed rulesets and branch protection, plus the Pulumi slice that applies them and pins the OIDC subject CI trusts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/infrastructure/infra-github"
  },
  "files": [
    "dist",
    "src",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ],
    "#node/*": [
      "./src/node/*",
      "./src/node/*.ts",
      "./src/node/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "@stackra/source": "./src/node/index.ts",
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@pulumi/github": "catalog:infra",
    "@pulumi/pulumi": "catalog:infra",
    "@stackra/contracts": "workspace:*",
    "@stackra/runway": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  }
}
