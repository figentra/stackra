# Stackra file contract:
# Purpose: runs testbed-guard.service five minutes after boot and every five minutes after.
# Boundary: timer only.
# Owner: release-operations · Secrets: forbidden
[Unit]
Description=Testbed agent guard timer

[Timer]
OnBootSec=5min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
