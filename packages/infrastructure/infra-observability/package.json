{
  "name": "@stackra/infra-observability",
  "version": "0.0.0",
  "private": true,
  "description": "Pulumi programs for telemetry read from the root runway (ADR 0184): the Better Stack OpenTelemetry source every service exports OTLP to, its hot log retention and the S3 cold archive, a Better Stack heartbeat per cron, outbox relay and worker in each deployed environment, the Sentry team, projects, DSN keys and new-issue alerts of the app members, and the service-level indicators of every service",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/infrastructure/infra-observability"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ],
    "#node/*": [
      "./src/node/*",
      "./src/node/*.ts",
      "./src/node/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "@stackra/source": "./src/node/index.ts",
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@pulumi/aws": "catalog:infra",
    "@pulumiverse/sentry": "catalog:infra",
    "@stackra/contracts": "workspace:*",
    "@stackra/runway": "workspace:*",
    "pulumi-better-uptime": "catalog:infra",
    "pulumi-logtail": "catalog:infra",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pulumi/pulumi": "catalog:infra",
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "peerDependencies": {
    "@pulumi/pulumi": "catalog:infra"
  }
}
