{
  "name": "@stackra/licensing",
  "version": "0.0.0",
  "private": true,
  "description": "Stackra licensing: the LicenceIssuer port and its Keygen and memory drivers for the issuing service, the on-prem install signer and usage-report exporter, and the LicenceVerifier port and its Keygen driver over the LicensingConfig configuration (API origin, account, verify key), reading a signed licence file offline, deriving the soft-enforcement standing (active, grace, read-only), and running the opt-in online key check for connected installs",
  "keywords": [
    "keygen",
    "licence",
    "licensing",
    "offline-verification",
    "on-prem",
    "security",
    "stackra",
    "usage-reporting"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/security/licensing#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/security/licensing"
  },
  "files": [
    "dist",
    "src",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#config/*": [
      "./src/config/*",
      "./src/config/*.ts"
    ],
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@stackra/config": "workspace:*",
    "@stackra/container": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/errors": "workspace:*",
    "@stackra/support": "workspace:*",
    "@stackra/transport": "workspace:*",
    "@stackra/validation": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "security",
    "runtimes": [
      "isomorphic"
    ],
    "summary": "Use it when an install must verify its signed licence offline and derive its standing (active, grace, read-only), or when the issuing service writes licences through the LicenceIssuer port."
  }
}
