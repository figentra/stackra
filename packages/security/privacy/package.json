{
  "name": "@stackra/privacy",
  "version": "0.0.0",
  "private": false,
  "description": "Stackra data-subject rights for PDPL and GDPR: the PersonalData kind each module declares (which model fields hold a subject's personal data and how each is erased), the DSAR export job that writes a subject's data across the declared models to a zip behind a signed, expiring link, and the erasure saga over @stackra/workflow that crypto-shreds the subject key, deletes or anonymises the rest, keeps what a legal hold covers and issues a receipt",
  "keywords": [
    "dsar",
    "erasure",
    "gdpr",
    "pdpl",
    "personal-data",
    "privacy",
    "security",
    "stackra"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/security/privacy#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/security/privacy"
  },
  "files": [
    "dist",
    "src",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#config/*": [
      "./src/config/*",
      "./src/config/*.ts"
    ],
    "#contracts/*": [
      "./src/contracts/*",
      "./src/contracts/*.ts",
      "./src/contracts/*/index.ts"
    ],
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ],
    "#node/*": [
      "./src/node/*",
      "./src/node/*.ts",
      "./src/node/*/index.ts"
    ],
    "#testing/*": [
      "./src/testing/*",
      "./src/testing/*.ts",
      "./src/testing/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./contracts": {
      "@stackra/source": "./src/contracts/index.ts",
      "types": "./dist/contracts.d.mts",
      "default": "./dist/contracts.mjs"
    },
    "./node": {
      "@stackra/source": "./src/node/index.ts",
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./testing": {
      "@stackra/source": "./src/testing/index.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@stackra/actions": "workspace:*",
    "@stackra/config": "workspace:*",
    "@stackra/container": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/data-transfer": "workspace:*",
    "@stackra/database": "workspace:*",
    "@stackra/events": "workspace:*",
    "@stackra/filesystem": "workspace:*",
    "@stackra/iam": "workspace:*",
    "@stackra/queue": "workspace:*",
    "@stackra/scheduler": "workspace:*",
    "@stackra/validation": "workspace:*",
    "@stackra/workflow": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "peerDependencies": {
    "@stackra/testing": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@stackra/testing": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "security",
    "runtimes": [
      "isomorphic",
      "node"
    ],
    "summary": "Reach for this when a person asks for their data or asks to be forgotten (PDPL, GDPR): modules declare their personal data with the PersonalData kind; this package exports it to a signed zip and erases it through a workflow that crypto-shreds, deletes or anonymises, honours legal holds and issues receipts."
  }
}
