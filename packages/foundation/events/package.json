{
  "name": "@stackra/events",
  "version": "0.0.0",
  "private": false,
  "description": "Stackra events: the DomainEvent, IntegrationEvent, WebhookEvent and AnalyticsEvent kind bases, the Listener kind base, the in-process EventBus, event recording kept off the aggregate, the EventOutbox and RegionBus ports and the event testing helpers",
  "keywords": [
    "analytics",
    "domain-events",
    "event-bus",
    "events",
    "foundation",
    "integration-events",
    "listeners",
    "stackra",
    "webhooks"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/foundation/events#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/foundation/events"
  },
  "files": [
    "dist",
    "src",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#contracts/*": [
      "./src/contracts/*",
      "./src/contracts/*.ts",
      "./src/contracts/*/index.ts"
    ],
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ],
    "#devtools/*": [
      "./src/devtools/*",
      "./src/devtools/*.ts",
      "./src/devtools/*/index.ts"
    ],
    "#testing/*": [
      "./src/testing/*",
      "./src/testing/*.ts",
      "./src/testing/*/index.ts"
    ],
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./contracts": {
      "@stackra/source": "./src/contracts/index.ts",
      "types": "./dist/contracts.d.mts",
      "default": "./dist/contracts.mjs"
    },
    "./devtools": {
      "@stackra/source": "./src/devtools/index.ts",
      "types": "./dist/devtools.d.mts",
      "default": "./dist/devtools.mjs"
    },
    "./testing": {
      "@stackra/source": "./src/testing/index.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@stackra/container": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/validation": "workspace:*"
  },
  "devDependencies": {
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@stackra/testing": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@stackra/testing": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "foundation",
    "runtimes": [
      "isomorphic",
      "node"
    ],
    "summary": "Reach for it to declare domain, integration, webhook or analytics events and their listeners, publish in process, or test emitted events; cross-service delivery goes through @stackra/outbox behind its EventOutbox port."
  }
}
