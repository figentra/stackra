{
  "name": "@stackra/validation",
  "version": "0.0.0",
  "private": false,
  "description": "Stackra shapes and field rules: the Schema kind base, CursorInput, TableInput, Page.of, PickType/OmitType/PartialType, typed field decorators, @Renamed, @Classified, the codecs generated schemas import and validate over the schema registry",
  "keywords": [
    "codecs",
    "decorators",
    "dto",
    "foundation",
    "pagination",
    "schemas",
    "stackra",
    "validation",
    "zod"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/foundation/validation#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/foundation/validation"
  },
  "files": [
    "dist",
    "src",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@stackra/container": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "foundation",
    "runtimes": [
      "isomorphic"
    ],
    "summary": "Reach for it to declare request, response or record shapes as classes with field rules and to validate raw input against them; stackra gen compiles them to zod, so zod is written by hand only through @Field."
  }
}
