{
  "name": "@stackra/i18n",
  "version": "0.0.0",
  "private": false,
  "description": "Stackra i18n: the Locale (seven languages and their overlays), NumberingSystem, HourCycle, LocaleUrlStrategy, LengthUnit and DisplayUnit enums, per-locale week start and clock (localeFormat), the I18nConfig configuration, the ICU message engine over namespaced catalogues with regional overlays, the typed key builder gen calls, the Arabic normaliser, digit switching, address, country, length and quantity formatting, the translation, geocoding and address-autocomplete ports (./contracts), the React provider and formatting hooks, and (./native) the native language switcher that follows the phone's per-app language or switches in place, with the phone's region formats and time zone",
  "keywords": [
    "arabic",
    "formatting",
    "foundation",
    "i18n",
    "icu",
    "locales",
    "localization",
    "stackra",
    "translations"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/foundation/i18n#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/foundation/i18n"
  },
  "files": [
    "dist",
    "src",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#config/*": [
      "./src/config/*",
      "./src/config/*.ts",
      "./src/config/*/index.ts"
    ],
    "#contracts/*": [
      "./src/contracts/*",
      "./src/contracts/*.ts",
      "./src/contracts/*/index.ts"
    ],
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ],
    "#native/*": [
      "./src/native/*",
      "./src/native/*.ts",
      "./src/native/*.tsx",
      "./src/native/*/index.ts"
    ],
    "#react/*": [
      "./src/react/*",
      "./src/react/*.ts",
      "./src/react/*.tsx",
      "./src/react/*/index.ts"
    ],
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./contracts": {
      "@stackra/source": "./src/contracts/index.ts",
      "types": "./dist/contracts.d.mts",
      "default": "./dist/contracts.mjs"
    },
    "./native": {
      "@stackra/source": "./src/native/index.ts",
      "types": "./dist/native.d.mts",
      "default": "./dist/native.mjs"
    },
    "./react": {
      "@stackra/source": "./src/react/index.ts",
      "types": "./dist/react.d.mts",
      "default": "./dist/react.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@stackra/config": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/money": "workspace:*",
    "@stackra/support": "workspace:*",
    "@stackra/validation": "workspace:*",
    "intl-messageformat": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stackra/container": "workspace:*",
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@testing-library/dom": "catalog:frontend",
    "@testing-library/react": "catalog:frontend",
    "@types/node": "catalog:",
    "@types/react": "catalog:frontend",
    "@types/react-dom": "catalog:frontend",
    "@vitest/coverage-v8": "catalog:quality",
    "expo-constants": "catalog:mobile",
    "expo-intent-launcher": "catalog:mobile",
    "expo-localization": "catalog:mobile",
    "expo-updates": "catalog:mobile",
    "jsdom": "catalog:frontend",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "react-native": "catalog:mobile",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "peerDependencies": {
    "expo-constants": "catalog:mobile",
    "expo-intent-launcher": "catalog:mobile",
    "expo-localization": "catalog:mobile",
    "expo-updates": "catalog:mobile",
    "react": "catalog:frontend",
    "react-native": "catalog:mobile"
  },
  "peerDependenciesMeta": {
    "expo-constants": {
      "optional": true
    },
    "expo-intent-launcher": {
      "optional": true
    },
    "expo-localization": {
      "optional": true
    },
    "expo-updates": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "foundation",
    "runtimes": [
      "isomorphic",
      "react-native"
    ],
    "summary": "Reach for it whenever user-facing text, numbers, dates, addresses or units must be translated or formatted per locale (Arabic included), or when adding catalogue keys; it also holds the translation, geocoding and address-autocomplete ports."
  }
}
