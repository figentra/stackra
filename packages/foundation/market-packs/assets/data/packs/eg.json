      "key": "identity.national_ids",
      "value": {
        "national_id": {
          "pattern": "^[23]\\d{13}$",
          "check": "century_birth_date"
        }
      },
      "from": "2000-01-01"
    },
    {
      "key": "identity.address_format",
      "value": {
        "required": ["locality", "region"],
        "region": {
          "pattern": "^(ALX|ASN|AST|BA|BH|BNS|C|DK|DT|FYM|GH|GZ|IS|JS|KB|KFS|KN|LX|MN|MNF|MT|PTS|SHG|SHR|SIN|SUZ|WAD)$"
        },
        "postalCode": {
          "pattern": "^\\d{5}$"
        },
        "maxLines": 2,
