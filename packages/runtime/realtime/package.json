{
  "name": "@stackra/realtime",
  "version": "0.0.0",
  "private": true,
  "description": "Stackra realtime: the channel hub that delivers data-free broadcast refreshes by audience and permission, the RealtimeDriver (server) and RealtimeTransport (client) ports with their memory, SSE and WebSocket drivers, the reconnecting client connection, RealtimeConfig with its shipped schema, useRealtimeConnection, useSubscription and fakeRealtime, the RealtimeFanout port with the local and Valkey pub/sub drivers and the RealtimeRelay across instances, and the collaboration rooms of ADR 0346 (RealtimeRooms with its caps and room_limit_reached)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/runtime/realtime"
  },
  "files": [
    "dist",
    "src",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#config/*": [
      "./src/config/*",
      "./src/config/*.ts"
    ],
    "#contracts/*": [
      "./src/contracts/*",
      "./src/contracts/*.ts",
      "./src/contracts/*/index.ts"
    ],
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ],
    "#node/*": [
      "./src/node/*",
      "./src/node/*.ts",
      "./src/node/*/index.ts"
    ],
    "#react/*": [
      "./src/react/*",
      "./src/react/*.ts",
      "./src/react/*.tsx",
      "./src/react/*/index.ts"
    ],
    "#testing/*": [
      "./src/testing/*",
      "./src/testing/*.ts",
      "./src/testing/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./contracts": {
      "@stackra/source": "./src/contracts/index.ts",
      "types": "./dist/contracts.d.mts",
      "default": "./dist/contracts.mjs"
    },
    "./node": {
      "@stackra/source": "./src/node/index.ts",
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./react": {
      "@stackra/source": "./src/react/index.ts",
      "types": "./dist/react.d.mts",
      "default": "./dist/react.mjs"
    },
    "./testing": {
      "@stackra/source": "./src/testing/index.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@stackra/config": "workspace:*",
    "@stackra/container": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/errors": "workspace:*",
    "@stackra/events": "workspace:*",
    "@stackra/transport": "workspace:*",
    "@stackra/validation": "workspace:*",
    "iovalkey": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@testing-library/dom": "catalog:frontend",
    "@testing-library/react": "catalog:frontend",
    "@types/node": "catalog:",
    "@types/react": "catalog:frontend",
    "@types/react-dom": "catalog:frontend",
    "@vitest/coverage-v8": "catalog:quality",
    "jsdom": "catalog:frontend",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "peerDependencies": {
    "react": "catalog:frontend"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
