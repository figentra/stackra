{
  "name": "@stackra/devices",
  "version": "0.1.0",
  "private": false,
  "description": "Stackra devices: the DeviceTelemetry, DeviceCommands, DeviceCredential, DeviceIdentity and DevicePairing ports a device app reports, takes commands, pairs and orders its offline calls through, the DeviceRegistry port with its memory driver, the stored identity and credential drivers, the DevicesConfig configuration with its shipped schema, the HTTP drivers over @stackra/transport, and the server's devices.device.acknowledged query",
  "keywords": [
    "device-pairing",
    "devices",
    "iot",
    "kiosk",
    "offline-sync",
    "runtime",
    "stackra",
    "telemetry"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/runtime/devices#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/runtime/devices"
  },
  "files": [
    "dist",
    "src",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#config/*": [
      "./src/config/*",
      "./src/config/*.ts"
    ],
    "#contracts/*": [
      "./src/contracts/*",
      "./src/contracts/*.ts",
      "./src/contracts/*/index.ts"
    ],
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ],
    "#node/*": [
      "./src/node/*",
      "./src/node/*.ts",
      "./src/node/*/index.ts"
    ],
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./contracts": {
      "@stackra/source": "./src/contracts/index.ts",
      "types": "./dist/contracts.d.mts",
      "default": "./dist/contracts.mjs"
    },
    "./node": {
      "@stackra/source": "./src/node/index.ts",
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@stackra/actions": "workspace:*",
    "@stackra/config": "workspace:*",
    "@stackra/container": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/errors": "workspace:*",
    "@stackra/iam": "workspace:*",
    "@stackra/storage": "workspace:*",
    "@stackra/transport": "workspace:*",
    "@stackra/validation": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "runtime",
    "runtimes": [
      "isomorphic",
      "node"
    ],
    "summary": "Reach for it when building a device app (sensor gateway, kiosk, till) that pairs, reports telemetry, takes commands or orders offline calls, or when the server tracks registered devices."
  }
}
