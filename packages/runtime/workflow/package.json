{
  "name": "@stackra/workflow",
  "version": "0.2.0",
  "private": false,
  "description": "Stackra workflow: the Workflow and Signal kind bases, the @Step method decorator and the Run<W> and StepContext types; the native engine that runs a workflow's steps in process, records every run and step in a durable journal (Postgres by default, memory for tests), parks a run on a signal or event wait, retries with backoff, times out steps and runs, compensates completed steps in reverse, and pins each run to the version it started on; the building-block registry, the automation document kind with its check and dry run, versioned Automation records with AutomationService, workflow template packs, and agent plans run as ephemeral document workflows; the publisher-access check that pauses an automation whose publisher lost access; the cross-service service-acked contract; the checklist engine with locked steps, scope and user progress and industry profiles; the WorkflowRunner driver behind ctx.run and ctx.signal, and the in-process test driver",
  "keywords": [
    "automation",
    "compensation",
    "durable-execution",
    "orchestration",
    "runtime",
    "saga",
    "signals",
    "stackra",
    "workflow"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/runtime/workflow#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/runtime/workflow"
  },
  "files": [
    "dist",
    "src",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#config/*": [
      "./src/config/*",
      "./src/config/*.ts"
    ],
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ],
    "#node/*": [
      "./src/node/*",
      "./src/node/*.ts",
      "./src/node/*/index.ts"
    ],
    "#testing/*": [
      "./src/testing/*",
      "./src/testing/*.ts",
      "./src/testing/*/index.ts"
    ],
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "@stackra/source": "./src/node/index.ts",
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./testing": {
      "@stackra/source": "./src/testing/index.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@stackra/actions": "workspace:*",
    "@stackra/config": "workspace:*",
    "@stackra/container": "workspace:*",
    "@stackra/content": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/database": "workspace:*",
    "@stackra/errors": "workspace:*",
    "@stackra/events": "workspace:*",
    "@stackra/locking": "workspace:*",
    "@stackra/model": "workspace:*",
    "@stackra/outbox": "workspace:*",
    "@stackra/queue": "workspace:*",
    "@stackra/rules": "workspace:*",
    "@stackra/validation": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stackra/i18n": "workspace:*",
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "runtime",
    "runtimes": [
      "isomorphic",
      "node"
    ],
    "summary": "Reach for it when an action crosses modules, calls an external system, must undo earlier steps on failure, waits for a human or an event, or must survive a restart; it also runs tenant automations built from blocks."
  }
}
