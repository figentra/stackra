{
  "name": "@stackra/commitlint-config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared commitlint preset: conventional commits, the house type list and lengths, and the opt-in refs-issue-key rule (the issue-tracker prefix is the rule's value).",
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/tooling/commitlint#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/tooling/commitlint"
  },
  "type": "module",
  "exports": {
    ".": "./src/preset.ts"
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@commitlint/config-conventional": "catalog:release"
  },
  "devDependencies": {
    "@stackra/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "config",
    "category": "tooling",
    "runtimes": [
      "node"
    ]
  }
}
