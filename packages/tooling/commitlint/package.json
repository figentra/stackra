{
  "name": "@stackra/commitlint-config",
  "version": "0.0.0",
  "private": false,
  "description": "Shared commitlint preset: conventional commits, the house type list and lengths, and the opt-in refs-issue-key rule (the issue-tracker prefix is the rule's value).",
  "keywords": [
    "commit-messages",
    "commitlint",
    "conventional-commits",
    "git",
    "preset",
    "stackra",
    "tooling"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/tooling/commitlint#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/tooling/commitlint"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@stackra/source": "./src/preset.ts",
      "types": "./dist/preset.d.ts",
      "default": "./dist/preset.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@commitlint/config-conventional": "catalog:release"
  },
  "devDependencies": {
    "@stackra/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "config",
    "category": "tooling",
    "runtimes": [
      "node"
    ],
    "summary": "Use it as the single extends of a repository's commitlint configuration, and to turn on the Refs issue-key footer rule with the tracker prefix."
  }
}
