{
  "name": "@stackra/oxlint-config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared oxlint presets. A workspace's .oxlintrc.jsonc extends exactly one role preset and declares no rules of its own.",
  "keywords": [
    "code-style",
    "lint-presets",
    "linting",
    "oxlint",
    "stackra",
    "static-analysis",
    "tooling"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/tooling/oxlint#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/tooling/oxlint"
  },
  "files": [
    "src/*.jsonc",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/base.jsonc",
    "./base": "./src/base.jsonc",
    "./node": "./src/node.jsonc",
    "./boundaries": "./src/boundaries.jsonc",
    "./decorators": "./src/decorators.jsonc",
    "./react": "./src/react.jsonc"
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@stackra/typescript-config": "workspace:*",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "vitest": "catalog:quality"
  },
  "peerDependencies": {
    "@stackra/coding-standard": "workspace:*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "config",
    "category": "tooling",
    "runtimes": [
      "node"
    ],
    "summary": "Use it when creating or changing a workspace's .oxlintrc.jsonc: extend exactly one role preset from this package's src/, and add or change lint rules here, never in the workspace."
  }
}
