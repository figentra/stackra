{
  "name": "@stackra/oxlint-config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared oxlint presets. A workspace's .oxlintrc.jsonc extends exactly one role preset and declares no rules of its own.",
  "license": "MIT",
  "files": [
    "src/*.jsonc",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/base.jsonc",
    "./base": "./src/base.jsonc",
    "./node": "./src/node.jsonc",
    "./boundaries": "./src/boundaries.jsonc",
    "./decorators": "./src/decorators.jsonc",
    "./react": "./src/react.jsonc"
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@stackra/typescript-config": "workspace:*",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "vitest": "catalog:quality"
  },
  "peerDependencies": {
    "@stackra/coding-standard": "workspace:*"
  }
}
