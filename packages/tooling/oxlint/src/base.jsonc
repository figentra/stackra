// Stackra file contract:
// Purpose: shared oxlint base — correctness and suspicious are errors (rule-gap B-1, stackra-230), `any` and unused code are errors;
//          house rules shipped as JS plugins are errors: every rule of @stackra/coding-standard (`stackra/*`, ADR 0129,
//          0294, 0305) and feature-flags/no-plan-targeting (ADR 0213 d7). Files are kebab-case (ADR 0006 d1); the
//          retired kind decorators and define* helpers are banned at the import (ADR 0294 R6, ADR 0305 r3).
//          The cheap set of rule-gap N-4, N-7 to N-10 (stackra-229, owner D11): ts-comment bans (ts-expect-error only
//          in tests, with a description), the small bug-catchers and autofixes at error, no-console in packages
//          (off for tools, hooks, plugins and apps), and the react, jsx-a11y and small React rules on every .tsx.
//          The B group rows B-1, B-2 and B-5 (stackra-230, owner D11): no warnings left, no-array-sort outside tests,
//          and the promise-executor, code-point, structured-clone and spread rules, all at error.
//          Do NOT extend directly from a workspace; extend a role preset (node/react/decorators).
// Scope: every TypeScript/JavaScript file in the repo
// Owner: release-operations
// Secrets: forbidden
{
  "$schema": "../../../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "jsdoc"],
  // Loaded from source (Node strips the types), so lint never needs a built dist and the root lint task keeps no
  // ^build dependency (ADR 0421). The paths are relative to this file. @stackra/coding-standard is also a peer of this
  // package so a consumer outside the repo installs it (it then names `@stackra/coding-standard`, not this path).
  "jsPlugins": [
    "../../../developer/coding-standard/src/core/constants/stackra-plugin.constant.ts",
    "../../../state/feature-flags/src/lint/constants/feature-flags-lint-plugin.constant.ts",
  ],
  // B-1: a warning never fails a member's `oxlint .`, so every category that is on is an error.
  "categories": { "correctness": "error", "suspicious": "error" },
  "env": { "es2024": true },
  "rules": {
    // Libraries log through @stackra/logger; tools, hooks, plugins and apps print (override below). N-10.
    "no-console": "error",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "error",
    // N-4: no silenced type error in shipped code. Tests may keep an @ts-expect-error with a description: a type
    // test asserts the error (rule 6e). The test override below allows it.
    "typescript/ban-ts-comment": [
      "error",
      { "ts-ignore": true, "ts-nocheck": true, "ts-expect-error": true, "ts-check": false },
    ],
    "typescript/prefer-ts-expect-error": "error",
    // N-7: small bug-catchers.
    "array-callback-return": "error",
    "no-self-compare": "error",
    "no-fallthrough": "error",
    "no-unreachable-loop": "error",
    "no-useless-assignment": "error",
    "no-loop-func": "error",
    "no-constructor-return": "error",
    "no-sequences": "error",
    "no-empty": "error",
    "no-useless-return": "error",
    "oxc/no-accumulating-spread": "error",
    "typescript/no-dynamic-delete": "error",
    "typescript/no-invalid-void-type": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-empty-interface": "error",
    "typescript/unified-signatures": "error",
    "typescript/prefer-for-of": "error",
    // N-8: cheap autofixes.
    "prefer-const": "error",
    "import/no-duplicates": "error",
    "typescript/no-import-type-side-effects": "error",
    // Schema and settings classes spell their field types for gen; parameters and variables do not.
    "typescript/no-inferrable-types": ["error", { "ignoreProperties": true }],
    "unicorn/prefer-set-has": "error",
    // It also flags `.filter(...).at(-1)`, whose fix `findLast` is ES2023; the base lib is ES2022, so those sites
    // carry a reasoned disable until the lib moves.
    "unicorn/prefer-array-find": "error",
    // Node's spelling. Packages whose contracts carry the WHATWG label `utf-8` as a wire value are exempt below.
    "unicorn/text-encoding-identifier-case": "error",
    "unicorn/prefer-at": "error",
    "unicorn/consistent-date-clone": "error",
    "unicorn/prefer-type-error": "error",
    "unicorn/no-useless-promise-resolve-reject": "error",
    // B-2: `.sort()` as a value can mutate an array the caller still holds. A bare `x.sort();` statement passes
    // (allowExpressionStatement). toSorted is ES2023 and the base lib is ES2022, so a site that sorts an array it
    // just built carries a reasoned disable until the lib moves; tests are off (override below).
    "unicorn/no-array-sort": ["error", { "allowExpressionStatement": true }],
    // B-5: an executor's return value is dropped; `charCodeAt` splits non-BMP text; a JSON round trip drops Dates;
    // spread over Array.from/concat/slice.
    "no-promise-executor-return": "error",
    "unicorn/prefer-code-point": "error",
    "unicorn/prefer-structured-clone": "error",
    "unicorn/prefer-spread": "error",
    // B-3: the mechanical autofix sweep. Readable money and byte constants, `case` blocks that cannot leak a
    // `const` into the next case, `replaceAll` over a global regex, and one name for a caught error.
    "unicorn/numeric-separators-style": "error",
    // B-3 keeps number-literal-case off: it wants uppercase hex digits and oxfmt prints them lowercase, so the two
    // would fight on every save. oxfmt already lowercases the `0x` prefix and the exponent `e`.
    "unicorn/number-literal-case": "off",
    "unicorn/switch-case-braces": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/catch-error-name": "error",
    // Empty files are allowed for placeholders and test setup.
    "unicorn/no-empty-file": "off",
    // Side-effect imports for CSS and polyfills.
    "import/no-unassigned-import": "off",
    "import/no-cycle": "error",
    // A flag is a release switch, never a commercial right (ADR 0213 decision 7).
    "feature-flags/no-plan-targeting": "error",
    // House rules (@stackra/coding-standard): every rule the plugin registers, all at error. Keep this list equal
    // to STACKRA_PLUGIN.rules; presets.test.ts checks it.
    "stackra/base-matches-suffix": "error",
    "stackra/disable-needs-reason": "error",
    "stackra/docblock-shape": "error",
    "stackra/file-contract": "error",
    "stackra/hook-file-name": "error",
    "stackra/lines-between-class-members": "error",
    "stackra/member-order": "error",
    "stackra/multiline-decorator-options": "error",
    "stackra/no-empty-decorator": "error",
    "stackra/no-empty-module": "error",
    "stackra/no-enum": "error",
    "stackra/no-hash-private": "error",
    "stackra/no-kind-decorator": "error",
    "stackra/no-parameter-decorator": "error",
    "stackra/no-raw-key-literal": "error",
    "stackra/no-tenant-vocabulary": "error",
    "stackra/one-declaration-per-file": "error",
    // Files under src/ are kebab-case (ADR 0006 d1, ADR 0231); directories are a validator check.
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    // Retired kind decorators and define* helpers (ADR 0294 R6, ADR 0305 r3). boundaries.jsonc repeats this
    // pattern in every no-restricted-imports override, because the last matching override replaces it.
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@stackra/*", "@stackra/*/*"],
            "importNames": ["defineConfig", "defineToken", "defineDriver", "Injectable", "Inject"],
            "message": "Retired: no @Injectable/@Inject (a class is a provider by its kind; the parameter type names the dependency) and define* only for defineApp/Service/Package/Worker (ADR 0294 R6, ADR 0305 r3).",
          },
        ],
      },
    ],
    // TSDoc tags (ADR 0007, amended 2026-10-21). oxlint 1.86 has no jsdoc/no-types, so the `{type}`
    // ban lives in tools/scripts/doc-standard.mjs.
    "jsdoc/check-tag-names": [
      "error",
      {
        "definedTags": [
          "alpha",
          "beta",
          "decorator",
          "defaultValue",
          "eventProperty",
          "experimental",
          "internal",
          "label",
          "link",
          "packageDocumentation",
          "privateRemarks",
          "public",
          "remarks",
          "sealed",
          "typeParam",
          "virtual",
        ],
      },
    ],
  },
  "overrides": [
    {
      // The plugin's own source and tests name the rule it ships (`no-tenant-vocabulary`); the vocabulary ban
      // targets product code, not the rule that defines it.
      "files": ["**/developer/coding-standard/src/**/*.ts"],
      "rules": { "stackra/no-tenant-vocabulary": "off" },
    },
    {
      // Tests feed raw keys as fixture data: gen's and runway's tests build the manifests the generated constants
      // come from, so no constant exists yet. Product code stays under R-56.
      "files": ["**/__tests__/**"],
      "rules": { "stackra/no-raw-key-literal": "off" },
    },
    {
      // B-1, B-2: a test sorts or reverses the array it just built, to get the order an assertion compares;
      // nothing else holds it.
      "files": ["**/__tests__/**", "**/*.test.*"],
      "rules": { "unicorn/no-array-sort": "off", "unicorn/no-array-reverse": "off" },
    },
    {
      // N-4: a type test asserts a type error with @ts-expect-error and says which one; ts-ignore stays banned.
      "files": ["**/__tests__/**", "**/*.test.*", "**/*.test-d.ts"],
      "rules": {
        "typescript/ban-ts-comment": [
          "error",
          {
            "ts-ignore": true,
            "ts-nocheck": true,
            "ts-expect-error": "allow-with-description",
            "ts-check": false,
          },
        ],
      },
    },
    {
      // N-8: the WHATWG encoding label `utf-8` is a wire value here: data-transfer's detected encodings (ADR 0367
      // d3) and fiscal's journal export format (`JournalExport.encoding`). Respelling it would change the contract.
      "files": ["**/packages/data/data-transfer/src/**", "**/packages/commerce/fiscal/src/**"],
      "rules": { "unicorn/text-encoding-identifier-case": "off" },
    },
    {
      // N-10: tools, agent hooks, editor plugins, a package's build scripts, apps and workers (tier:app) print by
      // design; package source uses the logger.
      "files": [
        "**/tools/**",
        "**/.agents/hooks/**",
        "**/.opencode/plugins/**",
        "**/packages/*/*/scripts/**",
        "**/apps/**",
        "**/workers/**",
      ],
      "rules": { "no-console": "off" },
    },
    {
      // N-1: a single-entry CLI (a repo script, an agent hook, an editor plugin) keeps its helpers beside its entry;
      // splitting them into files buys nothing. Member source keeps the rule.
      "files": ["**/tools/scripts/*.mjs", "**/.agents/hooks/*.mjs", "**/.opencode/plugins/**"],
      "rules": { "stackra/one-declaration-per-file": "off" },
    },
    {
      // N-2 and N-9: react.jsonc's rules on every .tsx file, plus the small React rules. Folded in here because a
      // member never extends react.jsonc (the root entry extends boundaries.jsonc), so its rules reached no file.
      "files": ["**/*.tsx"],
      "plugins": ["react", "jsx-a11y"],
      "env": { "browser": true },
      "rules": {
        "react/jsx-no-target-blank": "error",
        "react/react-in-jsx-scope": "off",
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error",
        "react/button-has-type": "error",
        "react/no-array-index-key": "error",
        "react/no-object-type-as-default-prop": "error",
        // `<>{node}</>` turns a ReactNode into the ReactElement a component's return type promises.
        "react/jsx-no-useless-fragment": ["error", { "allowExpressions": true }],
        // 110 sites, nearly all in ui primitives that wrap a role on purpose: the ui React hygiene batch
        // (stackra-233, rule-gap FB-5) decides each one. Every other jsx-a11y correctness rule is on at error.
        "jsx-a11y/prefer-tag-over-role": "off",
      },
    },
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/.turbo/**",
    "**/*.d.ts",
    "**/encore.gen/**",
  ],
}
