{
  "name": "@stackra/vitest-config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared vitest presets by member role: libraryPreset, servicePreset, appPreset, mobilePreset and toolingPreset, over the base, decorators and react presets and the coverage gate.",
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/tooling/vitest#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/tooling/vitest"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./preset": "./src/preset.ts",
    "./preset-decorators": "./src/preset-decorators.ts",
    "./preset-react": "./src/preset-react.ts",
    "./coverage": "./src/coverage.ts"
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitest/coverage-v8": "catalog:quality",
    "jsdom": "catalog:frontend",
    "vitest": "catalog:quality"
  },
  "devDependencies": {
    "@stackra/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "typescript": "catalog:build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "config",
    "category": "tooling",
    "runtimes": [
      "node"
    ]
  }
}
