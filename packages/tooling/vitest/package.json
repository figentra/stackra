{
  "name": "@stackra/vitest-config",
  "version": "0.0.0",
  "private": false,
  "description": "Shared vitest presets by member role: libraryPreset, servicePreset, appPreset, mobilePreset and toolingPreset, over the base, decorators and react presets and the coverage gate.",
  "keywords": [
    "coverage",
    "jsdom",
    "stackra",
    "test-presets",
    "testing",
    "tooling",
    "unit-tests",
    "vitest"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/tooling/vitest#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/tooling/vitest"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@stackra/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preset": {
      "@stackra/source": "./src/preset.ts",
      "types": "./dist/preset.d.ts",
      "default": "./dist/preset.js"
    },
    "./preset-decorators": {
      "@stackra/source": "./src/preset-decorators.ts",
      "types": "./dist/preset-decorators.d.ts",
      "default": "./dist/preset-decorators.js"
    },
    "./preset-react": {
      "@stackra/source": "./src/preset-react.ts",
      "types": "./dist/preset-react.d.ts",
      "default": "./dist/preset-react.js"
    },
    "./coverage": {
      "@stackra/source": "./src/coverage.ts",
      "types": "./dist/coverage.d.ts",
      "default": "./dist/coverage.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitest/coverage-v8": "catalog:quality",
    "jsdom": "catalog:frontend",
    "vitest": "catalog:quality"
  },
  "devDependencies": {
    "@stackra/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "typescript": "catalog:build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "config",
    "category": "tooling",
    "runtimes": [
      "node"
    ],
    "summary": "Use it in a workspace's vitest configuration to pick the role preset and the shared coverage gate; test settings change here, not per member."
  }
}
