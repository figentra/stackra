{
  "name": "@stackra/vitest-config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared vitest presets: base, decorators (legacy decorators, no metadata), react (jsdom). A workspace's vitest.config.ts extends one preset and adds only its include globs.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./preset.ts",
    "./preset": "./preset.ts",
    "./preset-decorators": "./preset-decorators.ts",
    "./preset-react": "./preset-react.ts",
    "./coverage": "./coverage.ts"
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "vitest": "catalog:quality"
  },
  "devDependencies": {
    "@stackra/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "typescript": "catalog:build"
  }
}
