// Stackra file contract:
// Purpose: React 19 libraries (packages/<category>/<name> with a React entry): DOM lib + automatic JSX.
// Owner: release-operations · Secrets: forbidden
{
  "display": "@stackra/typescript-config — react",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vitest/globals"]
  },
  // `.stackra/entry`: the entries gen writes, so tsdown's dts step emits their declarations.
  "include": [
    "${configDir}/src",
    "${configDir}/.stackra/entry",
    "${configDir}/tsdown.config.ts",
    "${configDir}/vitest.config.ts"
  ]
}
