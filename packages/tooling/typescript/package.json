{
  "name": "@stackra/typescript-config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared tsconfig presets. A workspace extends exactly one role preset and adds no compiler options of its own.",
  "license": "MIT",
  "files": [
    "*.json",
    "runtime.json",
    "app.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./base.json",
    "./base": "./base.json",
    "./node": "./node.json",
    "./library": "./library.json",
    "./decorators": "./decorators.json",
    "./decorators-react": "./decorators-react.json",
    "./encore": "./encore.json",
    "./react": "./react.json",
    "./vite": "./vite.json",
    "./vite-node": "./vite-node.json",
    "./runtime": "./runtime.json",
    "./app": "./app.json",
    "./expo": "./expo.json"
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "vitest": "catalog:quality"
  }
}
