{
  "name": "@stackra/typescript-config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared tsconfig presets. A workspace extends exactly one role preset and adds no compiler options of its own.",
  "keywords": [
    "compiler-options",
    "presets",
    "stackra",
    "tooling",
    "tsconfig",
    "typescript"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/tooling/typescript#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/tooling/typescript"
  },
  "files": [
    "src/*.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/base.json",
    "./base": "./src/base.json",
    "./node": "./src/node.json",
    "./library": "./src/library.json",
    "./decorators": "./src/decorators.json",
    "./decorators-react": "./src/decorators-react.json",
    "./encore": "./src/encore.json",
    "./react": "./src/react.json",
    "./vite": "./src/vite.json",
    "./vite-node": "./src/vite-node.json",
    "./runtime": "./src/runtime.json",
    "./app": "./src/app.json",
    "./expo": "./src/expo.json",
    "./mobile": "./src/mobile.json",
    "./service": "./src/service.json",
    "./tooling": "./src/tooling.json",
    "./desktop": "./src/desktop.json",
    "./service-worker": "./src/service-worker.json"
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "vitest": "catalog:quality"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "config",
    "category": "tooling",
    "runtimes": [
      "node"
    ],
    "summary": "Use it as the single extends of a workspace's tsconfig.json, picking the role preset (node, library, decorators, runtime and the others); compiler options change here, never in a member."
  }
}
