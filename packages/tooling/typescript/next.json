// Stackra file contract:
// Purpose: Next.js App Router apps (source in src/). The react preset plus what `next build` expects: the
//          automatic JSX runtime Next 16 requires, the `next` language-service plugin, and the generated route
//          types (`next typegen` writes next-env.d.ts and .next/types). Next skips rewriting a tsconfig that
//          `extends`, so every option it needs must be here.
// Owner: release-operations · Secrets: forbidden
{
  "display": "@stackra/typescript-config — next app",
  "extends": "./react.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["${configDir}/src/*"] }
  },
  "include": [
    "${configDir}/next-env.d.ts",
    "${configDir}/.next/types/**/*.ts",
    "${configDir}/.next/dev/types/**/*.ts",
    "${configDir}/src",
    "${configDir}/next.config.ts",
    "${configDir}/vitest.config.ts",
    "${configDir}/playwright.config.ts"
  ],
  "exclude": ["node_modules", "test-results", "playwright-report"]
}
