// Stackra file contract:
// Purpose: the tsconfig a runtime TypeScript loader (tsx in a package's `bin/*.mjs`) applies when it executes
//          workspace sources directly. tsx uses ONE tsconfig and applies it only to the files its `include`
//          matches; the decorators preset includes the package's own `src`, so sources of other workspace
//          packages (legacy parameter decorators in @stackra/container and friends) would be transformed
//          without `experimentalDecorators` and fail. This preset widens the match to every package. It is
//          referenced from `packages/<tier>/<name>/bin/tsconfig.runtime.json` (that depth is what the include
//          below assumes); never by tsc, the build or the tests.
// Owner: release-operations · Secrets: forbidden
{
  "display": "@stackra/typescript-config — runtime loader (tsx)",
  "extends": "./decorators.json",
  "include": [
    "${configDir}/../../../../packages/**/*.ts",
    "${configDir}/../../../../packages/**/*.tsx"
  ]
}
