// Stackra file contract:
// Purpose: a workspace that declares modules/providers with legacy decorators (the DI tier, ADR-0007).
//          `emitDecoratorMetadata` stays off everywhere: esbuild (Encore's bundler) never emits
//          `design:paramtypes`, so no code may depend on it; every dependency is named with @Inject(token).
//          Pair with `library({ decorators: true })` from @stackra/tsdown-config and the vitest decorators
//          preset so tsc, the build and the test transform agree. Lint with @stackra/oxlint-config/decorators.
// Owner: release-operations · Secrets: forbidden
{
  "display": "@stackra/typescript-config — decorators",
  "extends": "./library.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "erasableSyntaxOnly": false
  }
}
