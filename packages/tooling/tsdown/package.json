{
  "name": "@stackra/tsdown-config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared tsdown build preset for libraries: ESM, dts, sourcemaps, tree-shaking, optional legacy-decorator transform.",
  "keywords": [
    "build",
    "bundler",
    "decorators",
    "dts",
    "esm",
    "stackra",
    "tooling",
    "tsdown"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/tooling/tsdown#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/tooling/tsdown"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@stackra/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "tsdown": "catalog:build"
  },
  "devDependencies": {
    "@stackra/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "config",
    "category": "tooling",
    "runtimes": [
      "node"
    ],
    "summary": "Use it in a library's tsdown.config.ts through library() to build its entries to ESM with types and sourcemaps; build options change here, not per member."
  }
}
