{
  "name": "@stackra/content",
  "version": "0.0.0",
  "private": false,
  "description": "Stackra content: the built-in ContentEntryType, and bounded custom fields that are data only: CustomFieldType, strict field definitions, checkCustomFieldDefinition and checkCustomFields with their refusals, the CustomField and CustomFieldValueSet models with their migration, CustomFieldService, the HasCustomFields trait and the custom field limit entitlement, and the HasRevisions trait with its Revision model, migration and RevisionService, a subtype per custom field target for types defined at runtime, and ContentModule exporting both services",
  "keywords": [
    "cms",
    "content-types",
    "custom-fields",
    "data",
    "revisions",
    "stackra",
    "versioning"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/data/content#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/data/content"
  },
  "files": [
    "dist",
    "src",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ],
    "#node/*": [
      "./src/node/*",
      "./src/node/*.ts",
      "./src/node/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "@stackra/source": "./src/node/index.ts",
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@stackra/actions": "workspace:*",
    "@stackra/container": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/database": "workspace:*",
    "@stackra/entitlements": "workspace:*",
    "@stackra/errors": "workspace:*",
    "@stackra/model": "workspace:*",
    "@stackra/validation": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "data",
    "runtimes": [
      "isomorphic",
      "node"
    ],
    "summary": "Use it when a model needs tenant-defined custom fields, record revision history or the built-in content entry types, all stored as checked data rather than schema changes."
  }
}
