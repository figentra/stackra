{
  "name": "@stackra/documents",
  "version": "0.2.0",
  "private": false,
  "description": "Stackra documents: one print-document template model rendered to HTML, PDF (through the PdfEngine port) and DOCX, with bilingual layouts, bidi isolation, Arabic shaping for devices that cannot shape, QR codes, amounts in words, signed form PDFs with a content hash, the ESignatureProvider port and its Documenso connector",
  "keywords": [
    "bidi",
    "data",
    "docx",
    "e-signature",
    "invoices",
    "pdf",
    "print-templates",
    "stackra"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/data/documents#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/data/documents"
  },
  "files": [
    "dist",
    "src",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#config/*": [
      "./src/config/*",
      "./src/config/*.ts"
    ],
    "#contracts/*": [
      "./src/contracts/*",
      "./src/contracts/*.ts",
      "./src/contracts/*/index.ts"
    ],
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ],
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./contracts": {
      "@stackra/source": "./src/contracts/index.ts",
      "types": "./dist/contracts.d.mts",
      "default": "./dist/contracts.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@stackra/actions": "workspace:*",
    "@stackra/config": "workspace:*",
    "@stackra/container": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/data-transfer": "workspace:*",
    "@stackra/errors": "workspace:*",
    "@stackra/integrations": "workspace:*",
    "@stackra/support": "workspace:*",
    "@stackra/validation": "workspace:*",
    "docx": "catalog:documents",
    "uqr": "catalog:documents",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "data",
    "runtimes": [
      "isomorphic"
    ],
    "summary": "Use it to render a printable document such as a receipt, invoice, label or signed form from one template to HTML, PDF or DOCX, including bilingual Arabic layouts and e-signature requests."
  }
}
