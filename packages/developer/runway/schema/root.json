{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 3
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "providers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "environments": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": ["dev", "preview", "staging", "production"]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "destinations": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          },
          "topology": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["monolith", "grouped", "split"]
              },
              "isolate": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                }
              },
              "default": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "groups": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "members": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]*$"
                      }
                    },
                    "cpu": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "memory": {
                      "type": "string",
                      "pattern": "^\\d+(Mi|Gi)$"
                    },
                    "instances": {
                      "type": "object",
                      "properties": {
                        "min": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "max": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": ["min", "max"],
                      "additionalProperties": false
                    },
                    "scaling": {
                      "type": "object",
                      "properties": {
                        "metric": {
                          "type": "string",
                          "enum": ["cpu", "memory"]
                        },
                        "target": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        }
                      },
                      "required": ["metric", "target"],
                      "additionalProperties": false
                    },
                    "workers": {
                      "type": "object",
                      "properties": {
                        "split": {
                          "type": "boolean"
                        },
                        "cpu": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "memory": {
                          "type": "string",
                          "pattern": "^\\d+(Mi|Gi)$"
                        },
                        "instances": {
                          "type": "object",
                          "properties": {
                            "min": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "max": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": ["min", "max"],
                          "additionalProperties": false
                        }
                      },
                      "required": ["split"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["members", "cpu", "memory", "instances"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["mode"],
            "additionalProperties": false
          },
          "lanes": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "portStep": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "from": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            },
            "required": ["enabled"],
            "additionalProperties": false
          },
          "defaults": {
            "type": "object",
            "properties": {
              "service": {
                "type": "object",
                "properties": {
                  "config": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
                    },
                    "additionalProperties": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  }
                },
                "additionalProperties": {}
              },
              "app": {
                "type": "object",
                "properties": {
                  "config": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
                    },
                    "additionalProperties": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  }
                },
                "additionalProperties": {}
              }
            },
            "additionalProperties": {}
          }
        },
        "required": ["topology"],
        "additionalProperties": {}
      }
    },
    "targets": {
      "type": "object",
      "properties": {
        "electron-release": {
          "type": "object",
          "properties": {
            "feed": {
              "type": "object",
              "properties": {
                "publicOrigin": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": ["publicOrigin"],
              "additionalProperties": {}
            }
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": {}
    },
    "edge": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "secrets": {
      "type": "object",
      "properties": {
        "sync": {
          "type": "string",
          "minLength": 1
        },
        "defaultPath": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      }
    },
    "release": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "observability": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": ["version", "project", "environments"],
  "additionalProperties": false,
  "$id": "https://static.stackra.figentra.com/schemas/runway/root.json",
  "title": "Stackra root runway, format version 3"
}
