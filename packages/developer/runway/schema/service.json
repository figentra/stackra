{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 3
    },
    "requires": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "engine": {
            "type": "string",
            "enum": ["postgres", "valkey"]
          },
          "dedicated": {
            "default": false,
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["engine"],
        "additionalProperties": false
      }
    },
    "secrets": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "health": {
      "type": "object",
      "properties": {
        "readiness": {
          "type": "object",
          "properties": {
            "requireMigrations": {
              "type": "boolean"
            },
            "timeoutSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "liveness": {
          "type": "object",
          "properties": {
            "eventLoopLagMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "environments": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": ["dev", "preview", "staging", "production"]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "database": {
            "type": "object",
            "properties": {
              "plan": {
                "type": "string",
                "enum": ["shared", "dedicated"]
              },
              "storageGb": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "extensions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                }
              },
              "poolBudget": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "readReplica": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "cache": {
            "type": "object",
            "properties": {
              "memoryMb": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "replicas": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "eviction": {
                "type": "string",
                "enum": [
                  "noeviction",
                  "allkeys-lru",
                  "allkeys-lfu",
                  "allkeys-random",
                  "volatile-lru",
                  "volatile-lfu",
                  "volatile-random",
                  "volatile-ttl"
                ]
              }
            },
            "required": ["memoryMb", "eviction"],
            "additionalProperties": false
          },
          "buckets": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "storageGb": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["storageGb"],
              "additionalProperties": false
            }
          },
          "queues": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "visibilityTimeoutSeconds": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "dlq": {
                  "type": "boolean"
                }
              },
              "required": ["visibilityTimeoutSeconds"],
              "additionalProperties": false
            }
          },
          "crons": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            },
            "required": ["enabled"],
            "additionalProperties": false
          },
          "config": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
            },
            "additionalProperties": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "environments"],
  "additionalProperties": false,
  "$id": "https://static.stackra.figentra.com/schemas/runway/service.json",
  "title": "Stackra service runway, format version 3"
}
