/**
 * generated by stackra gen — do not edit; from the service layout and its @stackra/app dependency
 * Purpose: the HTTP adapter of @golden/service-catalogue: CORS preflights answered with 204, CORS headers on every
 *          answer, signed-in answers private, no-store, and every error answered with the ADR 0140 envelope and a
 *          correlation id.
 * Boundary: every raw endpoint answers through `answerHttp`; the headers come from `corsHeaders` over the bound
 *           `CorsConfig` (`app.cors`) and `apiCacheControl`, and the error answers from `answerFailure` (an
 *           unexpected error reported to `app.reporter`), never from this file.
 * Runtime: node
 */
import "./database";
import { Readable } from "node:stream";
import type { IncomingMessage, ServerResponse } from "node:http";

import {
  answerFailure,
  apiCacheControl,
  CallAuthenticator,
  CorsConfig,
  corsHeaders,
  correlationIdOf,
  HttpConfig,
  type KeyCallOptions,
  serveGuardedCall,
  VisitorConfig,
  VisitorIdentityService,
} from "@stackra/app/server";
import type { AnyClass, Container } from "@stackra/container";
import type { Actor } from "@stackra/contracts";
import { currentRequest } from "encore.dev";

import { app } from "../../.stackra/entry/server";

/**
 * Answers one request: an `OPTIONS` preflight with 204 and the CORS headers, any other with `handle`'s answer and
 * the CORS headers; `private, no-store` when the request is signed in or the answer sets a cookie (ADR 0325 r22).
 * Nothing it is handed throws past it: a refusal answers its kind's status and envelope, anything else is reported
 * to `app.reporter` and answered 500 `internal`, each with the request's one `correlationId` (ADR 0140).
 */
export async function answerHttp(
  request: Request,
  handle: (request: Request, container: Container, correlationId: string) => Promise<Response>,
): Promise<Response> {
  const correlationId = correlationIdOf(request, currentRequest()?.trace?.traceId);
  try {
    return await app.handlers.run(async (container) => {
      const cors = corsHeaders(request, container.get(CorsConfig));
      if (request.method === "OPTIONS") return new Response(null, { status: 204, headers: cors });
      let answered: Response;
      try {
        answered = await handle(request, container, correlationId);
      } catch (error) {
        answered = answerFailure(error, { correlationId, reporter: app.reporter });
      }
      // A fetched answer's headers are immutable: copy it once.
      const response = new Response(answered.body, answered);
      for (const [name, value] of cors)
        if (name === "vary") response.headers.append(name, value);
        else response.headers.set(name, value);
      const cacheControl = apiCacheControl(request, response);
      if (cacheControl !== undefined) response.headers.set("cache-control", cacheControl);
      return response;
    });
  } catch (error) {
    // The run was refused (the app is draining: 503) or failed around the call: no request container, no CORS.
    return answerFailure(error, { correlationId, reporter: app.reporter });
  }
}

/** What an endpoint states: its route, whether anonymous callers may reach it, its action, and the call it runs. */
interface Call {
  path: string;
  anonymous: boolean;
  action?: AnyClass;
  input?: AnyClass;
  raw?: boolean;
  execute: (
    container: Container,
    input: unknown,
    actor: Actor,
    request: Request,
    call: KeyCallOptions | undefined,
  ) => Promise<unknown>;
}

/**
 * Answers one Encore raw request through `serveGuardedCall`: the body is read once under the cap, every request
 * guard runs over its exact bytes, then the caller is authenticated and the call runs (STA-2577).
 */
export async function answerCall(req: IncomingMessage, resp: ServerResponse, call: Call): Promise<void> {
  const headers = new Headers();
  for (const [name, value] of Object.entries(req.headers))
    if (value !== undefined) headers.set(name, Array.isArray(value) ? value.join(", ") : value);
  const method = req.method ?? "GET";
  const request = new Request(new URL(req.url ?? "/", "http://encore"), {
    method,
    headers,
    ...(method === "GET" || method === "HEAD" ? {} : { body: Readable.toWeb(req), duplex: "half" }),
  } as RequestInit);
  const response = await answerHttp(request, (incoming, container, correlationId) =>
    serveGuardedCall({
      request: incoming,
      correlationId,
      path: call.path,
      anonymous: call.anonymous,
      action: call.action,
      input: call.input,
      raw: call.raw === true,
      maxBodyBytes: container.get(HttpConfig).maxBodyBytes,
      guard: (guarded) => app.handlers.guard(guarded, container),
      authenticate: (credentials) => new CallAuthenticator(container).authenticate(credentials),
      visitor: (guarded) => new VisitorIdentityService(container.get(VisitorConfig)).resolve(guarded),
      execute: (input, actor, guarded, options) => call.execute(container, input, actor, guarded, options),
    }),
  );
  for (const [name, value] of response.headers)
    if (name !== "set-cookie") resp.setHeader(name, value);
  const cookies = response.headers.getSetCookie();
  if (cookies.length > 0) resp.setHeader("set-cookie", cookies);
  resp.writeHead(response.status);
  // Streamed, not buffered: an event stream (a room member's fallback) never ends on its own.
  if (response.body === null) resp.end();
  else Readable.fromWeb(response.body as never).pipe(resp);
}
