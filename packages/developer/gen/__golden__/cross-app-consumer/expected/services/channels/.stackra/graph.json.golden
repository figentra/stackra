{
  "member": "channels",
  "package": "@golden/service-channels",
  "layout": "service",
  "modules": ["channels"],
  "calls": ["catalogue", "pay"],
  "eventsOut": [],
  "eventsIn": ["catalogue.item.published.v1", "payments.payment.captured.v1"],
  "tables": [],
  "packages": [
    "@stackra/actions",
    "@stackra/app",
    "@stackra/clients",
    "@stackra/config",
    "@stackra/container",
    "@stackra/contracts",
    "@stackra/database",
    "@stackra/errors",
    "@stackra/events",
    "@stackra/locking",
    "@stackra/money",
    "@stackra/outbox",
    "@stackra/queue",
    "@stackra/scheduler",
    "@stackra/settings",
    "@stackra/testing",
    "@stackra/tsdown-config",
    "@stackra/validation",
    "@stackra/vitest-config"
  ],
  "drivers": [
    {
      "port": "outbox.DeliveryDriver",
      "candidates": ["memory", "postgres"]
    },
    {
      "port": "outbox.EventSigner",
      "candidates": ["ed25519"]
    },
    {
      "port": "outbox.InboxDriver",
      "candidates": ["memory", "postgres"]
    },
    {
      "port": "outbox.InboxVerifier",
      "candidates": ["contract"]
    },
    {
      "port": "outbox.SubscriberSource",
      "candidates": ["config"]
    }
  ]
}
