/**
 * generated by stackra gen — do not edit; from assets/lang/<locale>/*.json (keys from each base locale) and the
 * assets/lang of @golden/pay-payments
 * Purpose: the typed translation keys of @golden/service-billing and of the packages it declares
 *          (`I18n.<namespace>.<path>` is `"<namespace>::<path>"`), its locales, and the lazy catalogue loaders
 *          `loadMessages` merges along a locale's fallback chain.
 * Boundary: reached as `#stackra/i18n`; a key is a branded string, never a raw one. Add a key to the base locale's
 *           JSON and run `stackra gen`.
 * Runtime: isomorphic
 */
import { keys, loadMessages as load } from "@stackra/i18n";

/** Every translation key of the member and its declared packages, by namespace. */
export const I18n = keys({
  "payments.plans": [
    "title"
  ],
  "plans": [
    "title"
  ]
});

/** The locales the member ships catalogues for. */
export const locales = ["en"] as const;

/** One lazy loader per namespace and locale file: the member's lang and its declared packages'. */
export const catalogues = {
  "payments.plans": {
    "en": () => import("@golden/pay-payments/assets/lang/en/plans.json", { with: { type: "json" } }),
  },
  "plans": {
    "en": () => import("../../assets/lang/en/plans.json", { with: { type: "json" } }),
  },
};

/** The merged messages of `locale` by namespace, along its fallback chain (`ar-SA`, `ar`, `en`). */
export const loadMessages = (locale: string) => load(catalogues, locale);
