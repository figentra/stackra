{
  "member": "shop",
  "package": "@golden/service-shop",
  "layout": "service",
  "modules": ["shop"],
  "calls": [],
  "eventsOut": ["shop.order.paid.v1"],
  "eventsIn": [],
  "tables": ["shop.customers", "shop.order_lines", "shop.orders"],
  "packages": [
    "@stackra/actions",
    "@stackra/app",
    "@stackra/clients",
    "@stackra/config",
    "@stackra/container",
    "@stackra/contracts",
    "@stackra/database",
    "@stackra/errors",
    "@stackra/events",
    "@stackra/locking",
    "@stackra/model",
    "@stackra/money",
    "@stackra/outbox",
    "@stackra/queue",
    "@stackra/scheduler",
    "@stackra/settings",
    "@stackra/testing",
    "@stackra/tsdown-config",
    "@stackra/validation",
    "@stackra/vitest-config"
  ],
  "drivers": [
    {
      "port": "outbox.DeliveryDriver",
      "candidates": ["memory", "postgres"]
    },
    {
      "port": "outbox.EventSigner",
      "candidates": ["ed25519"]
    },
    {
      "port": "outbox.InboxDriver",
      "candidates": ["memory", "postgres"]
    },
    {
      "port": "outbox.InboxVerifier",
      "candidates": ["contract"]
    },
    {
      "port": "outbox.SubscriberSource",
      "candidates": ["config"]
    },
    {
      "port": "shop.PaymentGateway",
      "candidates": ["stripe"]
    }
  ]
}
