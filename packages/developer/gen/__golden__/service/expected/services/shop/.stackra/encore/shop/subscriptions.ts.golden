/**
 * generated by stackra gen — do not edit; from the listeners of integration events (own and
 * #stackra/clients/<service>) and the stackra.manifest.json files
 * Purpose: the typed event subscriptions of @golden/service-shop: one per consumed integration event, into its
 *          inbox.
 * Boundary: each delivery runs InboxService#receive in the server app, so the inbox claims the event id once and
 *           runs the typed listeners of it; the producer is never edited, and a new consumed event is subscribed on
 *           the next gen run.
 * Runtime: node
 */
import type { EventEnvelope } from "@stackra/outbox/contracts";
import { InboxService } from "@stackra/outbox/node";
import type { BrokerMessage } from "@stackra/queue/contracts";
import { Subscription } from "encore.dev/pubsub";

import { app } from "../../entry/server";
import { eventShopOrderPaidV1 } from "./events";

/** Hands one delivered envelope to this service's inbox. */
function receive(message: BrokerMessage): Promise<void> {
  return app.handlers.run(async (container) => {
    await container.get(InboxService).receive(message.body as EventEnvelope);
  });
}

/** Delivers `shop.order.paid.v1` to this service's typed listeners. */
export const eventShopOrderPaidV1Subscription = new Subscription(eventShopOrderPaidV1, "shop-shop-order-paid-v1", {
  handler: receive,
});
