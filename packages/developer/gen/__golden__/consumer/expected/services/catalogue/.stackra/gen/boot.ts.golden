 * Purpose: the boot of @golden/service-catalogue: connects what needs the booted container, in order.
 * Boundary: the database url is Encore's, the replicas and the shutdown signal the runtime's; the relay's loop runs
 *           until the signal aborts, and `boot` resolves once everything is connected.
 * Runtime: node
 */
import type { Container } from "@stackra/container";
import { EventBus } from "@stackra/events";
import { InboxService, OutboxRelayService, OutboxWriterService } from "@stackra/outbox/node";

/** Connects the legal holds and the database, then the services that resolve classes from the container (the bus and inbox until shutdown), then the relay. */
export async function boot(
  container: Container,
  options: { readonly signal: AbortSignal },
): Promise<void> {
  if (options.signal.aborted) return;
  const bus = container.get(EventBus);
  bus.connect(container);
  const inbox = container.get(InboxService);
  inbox.connect(container);
  const disconnect = (): void => {
    bus.disconnect();
    inbox.disconnect();
  };
  if (options.signal.aborted) disconnect();
  else options.signal.addEventListener("abort", disconnect, { once: true });
  const relay = container.get(OutboxRelayService);
  relay.connect(container);
  void relay.work({ signal: options.signal });
}
