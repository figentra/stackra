/**
 * generated by stackra gen — do not edit; from stackra.manifest.json (the actions whose job has a cron)
 * Purpose: the Encore CronJobs of @golden/service-channels: one per cron action and the stored schedules' minute
 *          tick.
 * Boundary: every endpoint is internal and runs through the server app's handlers; the schedules are UTC, as the
 *           cron option writes them.
 * Runtime: node
 */
import { SchedulerService } from "@stackra/scheduler";
import { api } from "encore.dev/api";
import { CronJob } from "encore.dev/cron";

import { app } from "../../entry/server";

/** Runs Stored per-scope schedules on its schedule. */
export const schedulerSchedules = api({ expose: false }, async (): Promise<void> => {
  await app.handlers.run(async (container) => {
    await container.get(SchedulerService).tick(undefined, { crons: false });
  });
});

export const schedulerSchedulesJob = new CronJob("scheduler-schedules", {
  title: "Stored per-scope schedules",
  schedule: "* * * * *",
  endpoint: schedulerSchedules,
});
