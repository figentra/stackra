        "../../../.agents/rules/naming-and-casing.md",
      ],
    },
    "test:coverage": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../../apps/docs/src/docs/adr/0263-*.mdx",
        "../../../apps/docs/src/docs/adr/0294-*.mdx",
        "../../../apps/docs/src/docs/adr/0305-*.mdx",
