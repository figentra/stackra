{
  "name": "@stackra/vite-plugin",
  "version": "0.1.0",
  "private": false,
  "description": "The Stackra Vite preset: serves the generated #stackra/* modules, wires gen's class-component pass, and turns a member's stackra.config.ts plus the generated options into one Vite config (React or React Router on Workers, Tailwind v4, per-locale pages, the PWA, prerender, budgets and source maps)",
  "keywords": [
    "bundler",
    "cloudflare-workers",
    "developer",
    "pwa",
    "stackra",
    "tailwind",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/developer/vite-plugin#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/developer/vite-plugin"
  },
  "files": [
    "dist",
    "src",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ],
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "catalog:frontend",
    "@react-router/dev": "catalog:frontend",
    "@sentry/vite-plugin": "catalog:frontend",
    "@stackra/contracts": "workspace:*",
    "@stackra/gen": "workspace:*",
    "@stackra/i18n": "workspace:*",
    "@stackra/runway": "workspace:*",
    "@tailwindcss/vite": "catalog:frontend",
    "@vitejs/plugin-react": "catalog:frontend",
    "vite-plugin-pwa": "catalog:frontend"
  },
  "devDependencies": {
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vite": "catalog:frontend",
    "vitest": "catalog:quality"
  },
  "peerDependencies": {
    "vite": "catalog:frontend"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "developer",
    "runtimes": [
      "node"
    ],
    "summary": "Use it when a web member's build or dev server needs changing: it turns stackra.config.ts and the generated options into the one Vite config and serves the #stackra/* modules."
  }
}
