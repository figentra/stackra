{
  "name": "@stackra/cli",
  "version": "0.1.0",
  "private": false,
  "description": "The stackra binary: new (v3 packages, services and product seed packs), seed-pack (check and seed a product's defaults without touching tenant values), gen and gen --check, the member tool commands (dev, build, start, typecheck, test, lint) that run gen and then the tool with its generated config, check (the quality gate) with its validate, verify, code:check and code:fix aliases, ls over the committed manifests, and the local MCP and agent-file commands",
  "keywords": [
    "cli",
    "codegen",
    "developer",
    "monorepo",
    "quality-gate",
    "scaffolding",
    "stackra"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/developer/cli#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/developer/cli"
  },
  "bin": {
    "stackra": "./dist/stackra.mjs"
  },
  "files": [
    "dist",
    "src",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#node/*": [
      "./src/node/*",
      "./src/node/*.ts",
      "./src/node/*/index.ts"
    ],
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@stackra/config": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/gen": "workspace:*",
    "@stackra/mcp": "workspace:*",
    "@stackra/repo-checks": "workspace:*",
    "@stackra/runway": "workspace:*",
    "@stackra/skills": "workspace:*",
    "@stackra/support": "workspace:*",
    "vite": "catalog:frontend",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "developer",
    "runtimes": [
      "node"
    ],
    "summary": "Use it for any stackra command a developer or agent runs: scaffolding packages and services, gen, dev, build, test, lint, check, seed packs and the MCP commands."
  }
}
