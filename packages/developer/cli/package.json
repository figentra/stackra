{
  "name": "@stackra/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The stackra binary: new (v3 packages, services and product seed packs), seed-pack (check and seed a product's defaults without touching tenant values), gen and gen --check, the member tool commands (dev, build, start, typecheck, test, lint) that run gen and then the tool with its generated config, ls over the committed manifests, and the local MCP and agent-file commands",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/developer/cli"
  },
  "bin": {
    "stackra": "./dist/stackra.mjs"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#node/*": [
      "./src/node/*",
      "./src/node/*.ts",
      "./src/node/*/index.ts"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@stackra/contracts": "workspace:*",
    "@stackra/gen": "workspace:*",
    "@stackra/mcp": "workspace:*",
    "@stackra/support": "workspace:*",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  }
}
