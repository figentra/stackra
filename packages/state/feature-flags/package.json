{
  "name": "@stackra/feature-flags",
  "version": "0.0.0",
  "private": true,
  "description": "Stackra feature flags: the Flag({ default, expires, removalIssue, scopes }) kind, typed flag refs, the FlagProvider port with its config and PostHog drivers, the FlagReader, FeatureFlagsConfig with its shipped schema, useFlag and fakeFlags, and the feature-flags oxlint plugin with its no-plan-targeting rule",
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/state/feature-flags#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/state/feature-flags"
  },
  "files": [
    "dist",
    "src",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#config/*": [
      "./src/config/*",
      "./src/config/*.ts"
    ],
    "#contracts/*": [
      "./src/contracts/*",
      "./src/contracts/*.ts",
      "./src/contracts/*/index.ts"
    ],
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ],
    "#lint/*": [
      "./src/lint/*",
      "./src/lint/*.ts",
      "./src/lint/*/index.ts"
    ],
    "#react/*": [
      "./src/react/*",
      "./src/react/*.ts",
      "./src/react/*.tsx",
      "./src/react/*/index.ts"
    ],
    "#testing/*": [
      "./src/testing/*",
      "./src/testing/*.ts",
      "./src/testing/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./contracts": {
      "@stackra/source": "./src/contracts/index.ts",
      "types": "./dist/contracts.d.mts",
      "default": "./dist/contracts.mjs"
    },
    "./lint": {
      "@stackra/source": "./src/lint/index.ts",
      "types": "./dist/lint.d.mts",
      "default": "./dist/lint.mjs"
    },
    "./react": {
      "@stackra/source": "./src/react/index.ts",
      "types": "./dist/react.d.mts",
      "default": "./dist/react.mjs"
    },
    "./testing": {
      "@stackra/source": "./src/testing/index.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@stackra/config": "workspace:*",
    "@stackra/container": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/validation": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:frontend",
    "@types/react-dom": "catalog:frontend",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "peerDependencies": {
    "react": "catalog:frontend"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "state",
    "runtimes": [
      "isomorphic",
      "node"
    ]
  }
}
