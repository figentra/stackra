// Turborepo package configuration: extends the root turbo.jsonc and declares this member's tags
// (tier, category, runtimes; pnpm validate checks them). Member-only task overrides go here.
// Owner: release-operations · Secrets: forbidden
{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["tier:lib", "category:state", "runtime:isomorphic", "runtime:node"],
  "tasks": {
    // Type-aware lint reads @stackra/testing's built types (dist/index.mjs), so it waits for that build.
    "lint": { "dependsOn": ["@stackra/testing#build"] },
  },
}
