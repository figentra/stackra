{
  "name": "@stackra/actions",
  "version": "0.2.0",
  "private": false,
  "description": "Stackra actions: the Action, Query, Precondition, ExtensionPoint, Extension and Interceptor kind bases, the fixed action pipeline (tenancy, permission, precondition, entitlement, flag, idempotency, interceptors, handle), the idempotency and rate-limit stores behind ports, RequestContext, the RateLimitConfig configuration and the action testing helpers, the approval step (ApprovalGate), effect tags (bulk included), structural actions guarded by LiveConfigurationGuard, meters with the usage.recorded event, the outbox AuditTrail driver, and the Valkey idempotency and rate-limit stores with StoresConfig",
  "keywords": [
    "actions",
    "application",
    "approvals",
    "command-pipeline",
    "extension-points",
    "idempotency",
    "permissions",
    "queries",
    "rate-limiting",
    "stackra"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/application/actions#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/application/actions"
  },
  "files": [
    "dist",
    "src",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#config/*": [
      "./src/config/*",
      "./src/config/*.ts"
    ],
    "#contracts/*": [
      "./src/contracts/*",
      "./src/contracts/*.ts",
      "./src/contracts/*/index.ts"
    ],
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ],
    "#devtools/*": [
      "./src/devtools/*",
      "./src/devtools/*.ts",
      "./src/devtools/*/index.ts"
    ],
    "#node/*": [
      "./src/node/*",
      "./src/node/*.ts",
      "./src/node/*/index.ts"
    ],
    "#testing/*": [
      "./src/testing/*",
      "./src/testing/*.ts",
      "./src/testing/*/index.ts"
    ],
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./contracts": {
      "@stackra/source": "./src/contracts/index.ts",
      "types": "./dist/contracts.d.mts",
      "default": "./dist/contracts.mjs"
    },
    "./devtools": {
      "@stackra/source": "./src/devtools/index.ts",
      "types": "./dist/devtools.d.mts",
      "default": "./dist/devtools.mjs"
    },
    "./node": {
      "@stackra/source": "./src/node/index.ts",
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./testing": {
      "@stackra/source": "./src/testing/index.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@stackra/cache": "workspace:*",
    "@stackra/config": "workspace:*",
    "@stackra/container": "workspace:*",
    "@stackra/contracts": "workspace:*",
    "@stackra/errors": "workspace:*",
    "@stackra/events": "workspace:*",
    "@stackra/validation": "workspace:*",
    "iovalkey": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality"
  },
  "peerDependencies": {
    "@stackra/testing": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@stackra/testing": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "application",
    "runtimes": [
      "isomorphic",
      "node"
    ],
    "summary": "Reach for it whenever you write a module's actions, queries, preconditions, interceptors or extension points; it owns the fixed pipeline (tenancy, permission, idempotency, rate limit, approval) every Stackra mutation and read runs through."
  }
}
