        {
          "class": {
            "name": "Clock",
            "from": "@stackra/contracts"
          }
        },
        {
          "class": {
            "name": "AiMeter",
            "from": "@stackra/ai"
          }
        },
        {
          "class": {
            "name": "DiscoveryService",
            "from": "@stackra/container"
          }
