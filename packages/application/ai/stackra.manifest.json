        "navigate",
        "list_open",
        "filter",
        "sort",
        "select",
        "view_apply",
        "record_open",
        "prefill",
        "preview",
        "tour_start",
        "tour_next",
        "tour_stop",
        "point"
      ]
    },
    "ai.PageReadRefusal": {
      "type": "string",
