        "finishedAt": {
          "type": ["string", "null"],
          "format": "date-time",
          "default": null
        },
        "id": {
          "type": "string",
          "pattern": "^airun_[0-9A-Za-z]{26}$"
        },
        "tenantId": {
          "type": "string",
          "pattern": "^scp_[0-9A-Za-z]{26}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
