{
  "name": "@stackra/registry",
  "version": "0.0.0",
  "private": false,
  "description": "Stackra module catalogue validation for a registry service: the CatalogueManifest shape of a published stackra.manifest.json and validateCatalogue, which checks a set of manifests for structure, duplicate members, identity collisions, foreign namespaces, unknown modules and dependencies, and dependency cycles, returning deterministic diagnostics; plus the app market records the registry carries (AppReview with ReviewState and canTransitionReview, DeveloperSandbox, FeeSchedule, PartnerPayout with computePartnerPayout) and the edition install plan (EditionBundle, planEditionInstall)",
  "keywords": [
    "app-market",
    "application",
    "catalogue",
    "dependency-graph",
    "manifest",
    "registry",
    "stackra",
    "validation"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/packages/application/registry#readme",
  "bugs": {
    "url": "https://github.com/figentra/stackra/issues"
  },
  "license": "MIT",
  "author": "Figentra (https://figentra.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": "packages/application/registry"
  },
  "files": [
    "dist",
    "src",
    "assets",
    "stackra.manifest.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#core/*": [
      "./src/core/*",
      "./src/core/*.ts",
      "./src/core/*/index.ts"
    ],
    "#stackra/*": [
      "./.stackra/gen/*",
      "./.stackra/gen/*.ts",
      "./.stackra/gen/*.tsx",
      "./.stackra/gen/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "@stackra/source": "./src/core/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@stackra/contracts": "workspace:*",
    "@stackra/money": "workspace:*",
    "@stackra/validation": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stackra/testing": "workspace:*",
    "@stackra/tsdown-config": "workspace:*",
    "@stackra/typescript-config": "workspace:*",
    "@stackra/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:quality",
    "oxfmt": "catalog:quality",
    "oxlint": "catalog:quality",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:quality",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "stackra": {
    "kind": "package",
    "tier": "lib",
    "category": "application",
    "runtimes": [
      "isomorphic"
    ],
    "summary": "Use when building or testing a module registry service that validates published stackra.manifest.json catalogues and carries app market records such as reviews, developer sandboxes and fee schedules."
  }
}
