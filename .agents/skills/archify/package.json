{
  "name": "@stackra/skill-archify",
  "version": "3.2.0",
  "private": false,
  "type": "module",
  "description": "JSON-IR diagram renderers (architecture / workflow / sequence / dataflow / lifecycle / erd / class / tree / timeline / waterfall).",
  "license": "Apache-2.0",
  "keywords": [
    "stackra",
    "skill",
    "archify",
    "diagrams",
    "architecture",
    "explainer",
    "agent-skill"
  ],
  "homepage": "https://github.com/figentra/stackra/tree/main/.agents/skills/archify#readme",
  "bugs": "https://github.com/figentra/stackra/issues",
  "author": "tt-a1i (Archify)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figentra/stackra.git",
    "directory": ".agents/skills/archify"
  },
  "stackra": {
    "kind": "skill",
    "summary": "Reach for it when an agent must draw a checked architecture, workflow, sequence, data-flow, ERD or timeline diagram, or a one-page explainer, as standalone HTML."
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "archify": "./bin/archify.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate:viewer": "node ../scripts/generate-viewer.mjs",
    "check:viewer": "node ../scripts/generate-viewer.mjs --check",
    "generate:brand-marks": "node scripts/generate-brand-marks.mjs",
    "check:brand-marks": "node scripts/generate-brand-marks.mjs --check",
    "generate:validators": "node scripts/generate-validators.mjs",
    "check:validators": "node scripts/generate-validators.mjs --check",
    "check:release-identity": "node ../scripts/check-release-identity.mjs",
    "build:gallery": "node ../scripts/build-gallery.mjs ../docs",
    "build:guide": "node ../scripts/build-guide.mjs ../docs/guide.html",
    "build:start": "node ../scripts/build-start.mjs ../docs/start.html",
    "build:readme-showcase": "node ../scripts/build-readme-showcase.mjs",
    "test:webm": "npm --prefix .. run test:webm",
    "test:browser": "npm --prefix .. run test:browser",
    "test": "npm --prefix .. test",
    "render:examples": "node scripts/render-examples.mjs ../examples"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "simple-icons": "16.28.0"
  },
  "overrides": {
    "fast-uri": "^3.1.7"
  }
}
